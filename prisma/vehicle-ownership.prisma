/// Who owned a vehicle when (warranty-transfer-brief.md, 2026-11-20). One row per owner, newest open (`ownedUntil`
/// null) = the current owner, which Vehicle.contactId also names. Exactly one open row per vehicle, held by the
/// partial unique index "VehicleOwnership_one_open_per_vehicle" (migration 20261120170000_vehicle_ownership, which
/// also opens the first row on every vehicle insert). History (services, claims, job cards) stays on the vehicle and
/// is never moved. lib/vehicleOwnership.ts; rules in lib/vehicleTransferRules.ts.
model VehicleOwnership {
  id                String    @id @default(cuid())
  tenantId          String?
  vehicleId         String
  vehicle           Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  /// Null once that contact is purged from the trash: the row stays (the vehicle's history), the person's details go.
  contactId         String?
  contact           Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ownedFrom         DateTime
  ownedUntil        DateTime?
  /// registered (the first owner) | sold_privately | traded_in | inherited | company_change | correction | other
  reason            String
  odometerKm        Int?
  note              String?
  proofDocumentId   String?
  /// Did the warranty pass to this owner? carried | not_carried | pending (the workspace's rule at transfer time).
  warranty          String    @default("carried")
  /// The vehicle's fleet before this owner took over, so undoing the transfer can put it back.
  fleetIdBefore     String?
  transferredById   String?
  transferredByName String?
  createdAt         DateTime  @default(now())
  reversedAt        DateTime?
  reversedByName    String?

  @@index([vehicleId])
  @@index([contactId])
  @@index([tenantId])
}
