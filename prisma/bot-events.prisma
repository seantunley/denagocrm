/// Provider-delivered inbound chatbot events accepted for processing.
///
/// A row is leased while its webhook work is running and becomes `completed`
/// only after that work succeeds. A crashed invocation therefore becomes
/// claimable again when its lease expires instead of turning a retry into a
/// permanent no-op.
model BotInboundEvent {
  id          String    @id @default(cuid())
  tenantId    String
  channel     String
  providerId  String
  status      String    @default("running") // running | retry | completed
  attempts    Int       @default(1)
  leaseUntil  DateTime?
  completedAt DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, channel, providerId])
  @@index([tenantId, status, leaseUntil])
  @@index([createdAt])
}
