/// A business the workspace buys from or pays: the OEM, a delivery company, a wrap shop (Sean, 2026-11-09).
/// A deal declares its suppliers (DealVendor) and its file then asks each one for its quote, invoice and proof
/// of payment. Purchase orders name one too. Kept in Settings → Suppliers. No banking details (Sean: "No").
model Vendor {
  id                 String    @id @default(cuid())
  tenantId           String
  name               String
  /// What it is (lib/vendors.ts VENDOR_KINDS): oem | transport | wrap | finance | other.
  kind               String    @default("other")
  vatNumber          String?
  registrationNumber String?
  address            String?
  /// e.g. "30 days from invoice".
  paymentTerms       String?
  /// The reference their invoices and our payments to them carry, for matching proof of payment.
  paymentReference   String?
  phone              String?
  email              String?
  notes              String?
  /// The deal-file documents asked of THIS supplier, as a JSON array of document types (Sean, 2026-11-10).
  /// NULL = the workspace's default supplier list (lib/dealFile.ts DealFileConfig.supplierTypes).
  requiredDocuments  Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  documents        Document[]
  purchaseOrders   PurchaseOrder[]
  deals            DealVendor[]
  documentRequests DocumentRequest[]
  deliveries       VendorDelivery[]

  @@unique([tenantId, id])
  @@index([tenantId, name])
}

/// A delivery booked with a transport supplier (vendors plan step 2, 2026-11-09): OUTBOUND to the customer on a
/// deal (quoteId), or INBOUND to the warehouse on a purchase order (purchaseOrderId) — exactly one (a CHECK in the
/// migration; both composite tenant FKs). Sent to the supplier only on a click; staff move the status along.
/// No cost here: the delivery charge is already on the quote (Sean, 2026-11-09).
model VendorDelivery {
  id              String    @id @default(cuid())
  tenantId        String
  vendorId        String
  vendor          Vendor    @relation(fields: [tenantId, vendorId], references: [tenantId, id], onDelete: Cascade)
  quoteId         String?
  purchaseOrderId String?
  /// The day it is booked for.
  scheduledFor    DateTime
  fromAddress     String
  toAddress       String
  /// For the driver: gate code, contact on site, what to bring.
  note            String?
  /// requested | confirmed | collected | delivered | cancelled (lib/vendorDeliveryRules.ts).
  status          String    @default("requested")
  statusAt        DateTime  @default(now())
  /// Where the booking went: the email address, "copied" when staff sent it themselves (WhatsApp), or
  /// "arranged by hand" when it was already arranged (by phone) and only recorded here.
  sentTo          String
  createdById     String
  createdAt       DateTime  @default(now())

  @@unique([tenantId, id])
  @@index([tenantId, quoteId])
  @@index([tenantId, purchaseOrderId])
  @@index([tenantId, vendorId])
}

/// What a supplier's invoice says — read from the file by AI when it is filed as a "Supplier invoice", then
/// CONFIRMED (or corrected) by a person before anyone relies on it (review section E, 2026-11-09). One per document.
model SupplierInvoice {
  id            String    @id @default(cuid())
  tenantId      String
  documentId    String    @unique
  invoiceNumber String?
  invoiceDate   DateTime?
  dueDate       DateTime?
  /// In cents of `currency` (as written on the invoice; null = not read).
  totalCents    Int?
  currency      String?
  /// read (by AI, waiting for a person) | confirmed (a person checked it) | unreadable (nothing could be read)
  status        String    @default("read")
  readAt        DateTime  @default(now())
  confirmedAt   DateTime?
  confirmedById String?

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
}

/// A supplier asked for one of its papers on a deal through a link (2026-11-09, review section D): "Please upload
/// your invoice for Q-1029". The link opens a public upload page; what arrives is filed on the quote already
/// labelled with the type and the supplier. One file, once; it expires; staff can recall it. The token is stored as
/// its SHA-256 (hashSignToken) — the raw value exists only in the link.
model DocumentRequest {
  id              String    @id @default(cuid())
  tenantId        String
  token           String    @unique
  /// The deal's quote the paper is filed on (a composite tenant FK in the migration).
  quoteId         String
  vendorId        String
  vendor          Vendor    @relation(fields: [tenantId, vendorId], references: [tenantId, id], onDelete: Cascade)
  /// The document type asked for: a supplier quote, invoice or proof of payment.
  documentType    String
  /// Where the link went: the email address it was sent to, or "link copied" when staff sent it themselves.
  sentTo          String
  createdById     String
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  revokedById     String?
  /// The upload that answered it, once — the request then closes.
  fulfilledAt     DateTime?
  documentId      String?

  @@unique([tenantId, id])
  @@index([tenantId, quoteId])
  @@index([tenantId, vendorId])
}

/// A supplier declared on a deal, so the deal file asks for its papers before any arrive. The deal is its LEAD,
/// or the quote itself for a quote with no lead — exactly one of the two (a CHECK in the migration). The lead and
/// quote keys are composite tenant FKs in the migration SQL; one supplier once per deal (partial unique indexes).
model DealVendor {
  id          String   @id @default(cuid())
  tenantId    String
  leadId      String?
  quoteId     String?
  vendorId    String
  vendor      Vendor   @relation(fields: [tenantId, vendorId], references: [tenantId, id], onDelete: Cascade)
  createdById String?
  createdAt   DateTime @default(now())

  @@index([tenantId, leadId])
  @@index([tenantId, quoteId])
  @@index([tenantId, vendorId])
}
