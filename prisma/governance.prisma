/// Sales pipeline container. Existing PipelineStage rows are linked by the
/// pipelineId column added in migration 52_pipelines_forecasting_rbac_audit —
/// the same migration that creates this table, backfills every pre-existing
/// stage to 'pipeline_default_retail' and then SETs the column NOT NULL. (This
/// note used to say "migration 45"; 45 is 45_document_versioning and has nothing
/// to do with pipelines. The wrong pointer is part of why the column went five
/// migrations without ever being declared on the model.)
///
/// The PipelineStage model still lives in schema.prisma. Prisma runs in FOLDER
/// mode here (`schema: "./prisma"`, see package.json prisma:generate), so every
/// prisma/*.prisma file is one schema and the relation below crosses files
/// legitimately — no import, no duplication.
model SalesPipeline {
  id          String   @id @default(cuid())
  tenantId    String? // Multi-tenancy (Phase B — additive/inert): owning tenant. Each dealer configures its own pipeline stages.
  name        String
  description String?
  type        String   @default("sales")
  active      Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  stages PipelineStage[]

  @@index([tenantId])
}

model Team {
  id          String   @id @default(cuid())
  tenantId    String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  name        String
  description String?
  active      Boolean  @default(true)
  managerId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  members TeamMember[]

  @@index([managerId])
  @@index([tenantId])
}

model TeamMember {
  id        String   @id @default(cuid())
  tenantId  String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  teamId    String
  userId    String
  isManager Boolean  @default(false)
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@index([tenantId])
}

model Role {
  id          String   @id @default(cuid())
  // Multi-tenancy (Phase B — additive/inert): NULL = system/seeded role, shared
  // globally by every tenant (see `system`). Non-null = one tenant's own
  // custom-authored role. Name uniqueness is enforced by two PARTIAL unique
  // indexes created by hand in migration 20260727100000 (Prisma's schema DSL
  // can't express a partial index): system role names are unique among
  // themselves (tenantId IS NULL), and tenant-authored names are unique per
  // tenant (tenantId, name) — see that migration for the exact SQL. The plain
  // `@unique` on `name` that used to live here is gone for that reason.
  tenantId    String?
  name        String
  description String?
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@index([tenantId])
}

model Permission {
  key         String @id
  description String
  category    String

  roles RolePermission[]
}

model RolePermission {
  roleId        String
  permissionKey String
  // Multi-tenancy (Phase B — additive/inert): denormalized copy of the owning
  // Role's tenantId (NULL for a system role's permissions), so raw-SQL reads
  // can filter directly without a join — matches the CampaignRecipient/Campaign
  // denormalization convention (see marketingCampaignQueue.ts).
  tenantId      String?

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([tenantId])
}

model UserRole {
  // Surrogate PK. A role ASSIGNMENT is unique PER TENANT (a user may hold the same
  // global role in more than one tenant), so identity must include tenantId. But
  // tenantId is nullable (Phase B — additive/inert) and Prisma forbids nullable
  // fields in @@id, so we can't use a composite PK. Instead: surrogate `id` PK +
  // a tenant-aware @@unique. Role/Permission/RolePermission stay GLOBAL (one shared
  // taxonomy); only the assignment of a role TO a user is tenant-scoped.
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  tenantId  String? // Multi-tenancy (Phase B — additive/inert): owning tenant. See note above.
  createdAt DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, roleId])
  @@index([roleId])
  @@index([tenantId])
}

model ForecastSnapshot {
  id                   String   @id @default(cuid())
  tenantId             String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  period               String
  pipelineId           String?
  teamId               String?
  userId               String?
  openValueCents       BigInt
  weightedValueCents   BigInt
  commitValueCents     BigInt
  bestCaseValueCents   BigInt
  opportunityCount     Int
  capturedAt           DateTime @default(now())

  @@index([period, capturedAt])
  @@index([pipelineId, teamId, userId, capturedAt])
  @@index([tenantId])
}

/// Professional append-only audit stream. Database triggers reject UPDATE and DELETE.
model AuditEvent {
  id                String   @id @default(cuid())
  tenantId          String? // Multi-tenancy (Phase B — additive/inert): owning tenant. Nullable: platform/super-admin actions have no owning tenant.
  actorUserId       String?
  actorName         String
  actorType         String   @default("user")
  eventType         String
  entityType        String?
  entityId          String?
  summary           String
  beforeJson        Json?
  afterJson         Json?
  changedFieldsJson Json?
  source            String   @default("app")
  ipAddress         String?
  userAgent         String?
  correlationId     String?
  metadata          Json?
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([eventType, createdAt])
  @@index([tenantId])
}
