// CampaignVersion and CampaignEvent intentionally use loose campaign/contact IDs
// in this first additive phase. The legacy Campaign model remains untouched until
// the draft/editor PR starts reading the new columns through Prisma.

model CampaignVersion {
  id            String   @id @default(cuid())
  tenantId      String?
  campaignId    String
  version       Int
  snapshot      Json
  reason        String?
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())

  @@unique([campaignId, version])
  @@index([campaignId, createdAt(sort: Desc)])
  @@index([tenantId])
}

model CampaignEvent {
  id                  String   @id @default(cuid())
  tenantId            String?
  campaignId          String
  campaignRecipientId String?
  contactId           String?
  type                String
  url                 String?
  providerMessageId   String?
  metadata            Json?
  occurredAt          DateTime @default(now())

  @@index([campaignId, type, occurredAt])
  @@index([campaignRecipientId, occurredAt])
  @@index([contactId, occurredAt])
  @@index([tenantId])
}
