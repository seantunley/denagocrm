/// Versioned multi-step marketing journeys and CRM automations.
/// Kept in a separate Prisma schema file so the domain can evolve independently.
model Journey {
  id            String   @id @default(cuid())
  tenantId      String?
  name          String
  description   String?
  category      String   @default("automation") // automation | marketing
  status        String   @default("draft") // draft | active | paused | archived
  /// What happens when someone is enrolled again while a run is still open.
  ///
  /// There was exactly one implicit answer here — the idempotency key made a repeat
  /// enrolment on the SAME event a no-op, but a *different* event on the same
  /// person started a second run, silently, and both then sent.
  ///
  ///   single   the open run wins; a new enrolment is dropped (the default,
  ///            because it is what a drip sequence almost always wants)
  ///   restart  the open run is cancelled and the new one replaces it
  ///   queued   the new run waits and starts when the open one finishes
  ///   parallel both run — the pre-existing behaviour, kept for the cases that
  ///            genuinely want it
  runMode       String   @default("single") // single | restart | queued | parallel
  activeVersion Int?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  versions JourneyVersion[]
  runs     JourneyRun[]
  events   JourneyEvent[]

  @@index([status, category])
  @@index([tenantId])
}

model JourneyVersion {
  id              String    @id @default(cuid())
  tenantId        String?
  journeyId       String
  journey         Journey   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  version         Int
  state           String    @default("draft") // draft | published | retired
  /// WHAT ENROLS SOMEONE — a list, `[{ id?, type, config }]`. See journeyTriggers.ts.
  ///
  /// Replaces a single `trigger` string plus one shared `triggerConfig`, under
  /// which "enrol when a lead is created OR when one is imported" was two
  /// identical journeys maintained side by side.
  ///
  /// JSON rather than a child table because a published version is IMMUTABLE:
  /// no row of this list is ever updated after publish, so there is no
  /// independent lifetime for a child row to have. It is part of the version
  /// document, exactly as `definition` and `entryConditions` are. Nor does the
  /// matcher query by trigger — `processOneEvent` loads the ACTIVE journeys once
  /// per event and compares in memory — so a child table would add a join to
  /// every read, plus a fourth journey table needing its own tenant column and
  /// RLS policy, to speed up a filter that does not exist.
  ///
  /// Config is PER trigger, not shared. Every key the old shared bag held
  /// qualified exactly one trigger type (`stageId`, `idleDays`, `segmentId`,
  /// `inactiveMonths`), so one bag could not express the first thing anyone
  /// wants out of this: "entered Quoted OR entered Won".
  triggers        Json
  /// EXPAND PHASE — the old single-trigger pair, kept for exactly one release.
  ///
  /// vercel.json runs `apply-migrations && next build`, so the schema changes
  /// while the PREVIOUS deployment is still serving production, and that build
  /// reads these two columns. Dropping them in the same release would break the
  /// app that is live at that moment, and keep it broken if the build failed.
  /// So both representations exist, every writer populates both (dual-write),
  /// and a follow-up CONTRACT migration removes these — plus the dual-write and
  /// the index below — once this release is deployed and verified.
  ///
  /// Nothing READS these any more: `triggers` is the single source of truth for
  /// what a version listens for. They are written only so the older build stays
  /// correct for the length of the rollout.
  trigger         String
  triggerConfig   Json?
  entryConditions Json?
  definition      Json
  createdById     String?
  createdAt       DateTime  @default(now())
  publishedAt     DateTime?

  runs JourneyRun[]

  @@unique([journeyId, version])
  @@index([journeyId, state])
  /// Kept for the expand phase only — the previous build still issues
  /// `WHERE "trigger" = … AND "state" = …` and must not start seq-scanning
  /// mid-rollout. Nothing on THIS build filters versions by trigger any more:
  /// the enrolment matcher and the pipeline stage badges both load the active
  /// journeys they already need and choose in memory, over a list of at most
  /// JOURNEY_LIMITS.triggers entries. The contract migration drops it with the
  /// column.
  @@index([trigger, state])
  @@index([tenantId])
}

/// Durable incoming event. Events are intentionally small and provider-neutral.
model JourneyEvent {
  id          String    @id @default(cuid())
  tenantId    String?
  journeyId   String?
  journey     Journey?  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  type        String
  entityType  String // lead | contact
  entityId    String
  payload     Json?
  status      String    @default("pending") // pending | processing | processed | failed
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  processedAt DateTime?
  error       String?
  /// Why each active journey did or did not enrol on this event:
  /// [{ journeyId, journeyName, enrolled, reason }].
  ///
  /// Processing decided this in a loop of bare `continue`s, so a journey that
  /// was never considered looked exactly like one that was considered and did
  /// not match — and a TRIGGER THAT NOBODY EMITS looked exactly like a trigger
  /// nobody matched. That is how "New lead created" journeys sat active,
  /// enrolling nobody, with nothing on screen to say so. Recording the decision
  /// is what makes the difference visible.
  decisions   Json?
  dedupeKey   String    @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, availableAt])
  @@index([type, status])
  @@index([journeyId, status])
  @@index([tenantId])
  /// The retention sweep's early-out: "is any processed event older than the
  /// cutoff?", asked once per tenant on every cron tick. Without this it is a
  /// sequential scan of the largest table in the schema, every tick, usually to
  /// find nothing — housekeeping that costs more than the thing it cleans up.
  ///
  /// tenantId LEADS, and that is the whole point. The sweep runs inside a tenant
  /// scope (runCronPerTenant), so the query the extension actually emits is
  /// `tenantId = $1 AND status IN (…) AND createdAt < $2`. Ordered
  /// [status, createdAt], a tenant with nothing to prune still walks the expired
  /// entries of every OTHER tenant before returning empty — so the busiest
  /// workspace sets the cost of the quietest one's early-out, on every tick.
  @@index([tenantId, status, createdAt])
  /// What a parked `wait_for_trigger` asks on every poll: "has an event of one
  /// of these types been recorded for this entity since I started listening".
  ///
  /// Column order matters — entity first, because it is the equality that cuts
  /// the table down to one person's handful of rows; then type (an IN list);
  /// then createdAt, which is the range and so has to come last to be usable.
  /// Without this the waiter is a sequential scan of every event ever recorded,
  /// once per waiting run, per engine tick.
  ///
  /// Distinct from the retention index above and both are needed: that one
  /// answers "anything old, anywhere in this tenant", this one answers "anything
  /// new, for this one person". Neither serves the other's leading column.
  @@index([entityType, entityId, type, createdAt])
}

/// A run is pinned to an immutable published version.
model JourneyRun {
  id               String         @id @default(cuid())
  tenantId         String?
  journeyId        String
  journey          Journey        @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  journeyVersionId String
  journeyVersion   JourneyVersion @relation(fields: [journeyVersionId], references: [id], onDelete: Restrict)
  status           String         @default("queued") // queued | running | waiting | blocked | completed | failed | cancelled
  /// Set on a run parked by run mode "queued": it starts when this predecessor
  /// closes. Not a foreign key — the predecessor can be purged while this row
  /// still names it, and a dangling id must not block the sweep from releasing.
  blockedByRunId   String?
  entityType       String
  entityId         String
  leadId           String?
  contactId        String?
  /// The TOP-LEVEL step. Still the whole position for a flat journey, which is
  /// every journey written before nesting existed.
  currentStepId    String?
  /// WHERE INSIDE a choose/repeat the run is: `{ stepId, frames[] }`.
  ///
  /// A journey step list is flat at the top level and nests only inside the two
  /// container steps, so one step id stopped being enough to say where a run is
  /// — a run parked on the second step of the third iteration of a repeat needs
  /// the iteration and the index too. There is no call stack to resume from:
  /// `processOneRun` executes at most twenty steps and parks, and a `wait` can
  /// hold a run for days before a DIFFERENT process picks it up. So the frame
  /// stack is a value here, and the run is rebuilt from it plus the pinned
  /// (immutable) version definition.
  ///
  /// NULL means flat — read as `{ stepId: currentStepId, frames: [] }`, which is
  /// exactly how every pre-existing run resumes across the deploy.
  cursor           Json?
  context          Json
  nextRunAt        DateTime       @default(now())
  /// Lifetime steps executed, across every tick and every wait.
  ///
  /// This is what bounds a run. The old cycle detector was a `visited` Set of
  /// step ids rebuilt per tick: too strict for `repeat`, which re-executes the
  /// same ids by design, and too weak for the real infinite automation — a
  /// back-edge with a wait in it went round forever, one step per tick, and the
  /// per-tick Set never saw it twice.
  stepsExecuted    Int            @default(0)
  attempts         Int            @default(0)
  lastError        String?
  idempotencyKey   String         @unique
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  stepLogs JourneyStepLog[]

  @@index([status, nextRunAt])
  /// Same reason as JourneyEvent's: the retention sweep asks "any CLOSED run
  /// older than the cutoff?" once per tenant per tick, and answers "no" almost
  /// every time. [status, nextRunAt] cannot serve it — nextRunAt is null on
  /// closed runs, which is exactly the set being scanned.
  ///
  /// tenantId leads for the same reason it does on JourneyEvent: the sweep runs
  /// under a tenant scope, and without it one workspace's backlog is scanned by
  /// every other workspace's tick.
  @@index([tenantId, status, createdAt])
  @@index([journeyId, status])
  @@index([entityType, entityId])
  @@index([leadId])
  @@index([contactId])
  @@index([tenantId])
}

model JourneyStepLog {
  id          String     @id @default(cuid())
  tenantId    String?
  runId       String
  run         JourneyRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// The hierarchical trace path: the step id, plus one segment per container
  /// the run had entered when it executed.
  ///
  ///   welcome                     a top-level step — identical to its id, which
  ///                               is why every pre-existing row backfills
  ///                               cleanly and the activity trace is unchanged
  ///   triage/choose/1/sequence/0  first step of the second branch
  ///   blast/repeat/2/sequence/1   second step of the THIRD iteration
  ///
  /// The iteration number is in here on purpose: `@@unique([runId, stepId])`
  /// could not survive `repeat`, because the same step id executes once per
  /// pass and the second write would have collided with — or silently
  /// overwritten — the first. Uniqueness moves to the path, which differs per
  /// execution, so every iteration keeps its own record.
  path        String
  /// The node's own id. Kept alongside `path` because it is what a person
  /// recognises, and what the existing trace UI reads.
  stepId      String
  stepType    String
  status      String // running | completed | skipped | failed
  note        String?
  output      Json?
  startedAt   DateTime   @default(now())
  completedAt DateTime?

  @@unique([runId, path])
  @@index([runId, stepId])
  @@index([runId, startedAt])
  @@index([status, startedAt])
  @@index([tenantId])
}
