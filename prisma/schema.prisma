// ── Competitor intelligence ──────────────────────────────────────────────────
// CRM-native, low-noise competitor monitoring: watch a few public pages per
// competitor, snapshot only on change, and AI-classify material changes for
// review. Single-tenant. Added by migration 72_competitor_intelligence.

model Competitor {
  id          String    @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  name        String
  website     String?
  description String?
  tier        Int       @default(2) // 1 critical · 2 important · 3 peripheral
  status      String    @default("active") // active | archived
  notes       String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?

  lastResearchedAt DateTime? // last AI deep-research pass (weekly cadence)

  sources   CompetitorSource[]
  snapshots CompetitorSnapshot[]
  changes   CompetitorChange[]
  briefs    CompetitorBrief[]

  @@index([status, name])
  @@index([tenantId])
  @@unique([tenantId, id])
}

model CompetitorSource {
  id            String    @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  competitorId  String
  label         String
  url           String
  sourceType    String    @default("page") // page | pricing | changelog | blog
  active        Boolean   @default(true)
  lastCheckedAt DateTime?
  lastChangedAt DateTime?
  lastStatus    String? // ok | error
  lastError     String?
  contentHash   String? // hash of the last successful snapshot
  collectingAt  DateTime? // collection lease: set while a run holds this source, cleared after
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  competitor Competitor           @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  snapshots  CompetitorSnapshot[]
  changes    CompetitorChange[]

  @@index([competitorId])
  @@index([active, lastCheckedAt])
  @@index([tenantId])
  @@unique([tenantId, id])
}

model CompetitorSnapshot {
  id           String   @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  competitorId String
  sourceId     String
  contentHash  String
  title        String?
  cleanText    String // normalised visible text (also used for diffing)
  rawRef       String? // storage ref of the raw HTML
  wordCount    Int      @default(0)
  fetchedAt    DateTime @default(now())

  competitor Competitor       @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  source     CompetitorSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, fetchedAt])
  @@index([tenantId])
}

model CompetitorChange {
  id             String    @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  competitorId   String
  sourceId       String
  prevSnapshotId String?
  snapshotId     String
  status         String    @default("new") // new | reviewed | dismissed
  materiality    String    @default("minor") // noise | minor | important | critical
  category       String? // pricing | product | messaging | hiring | other
  summary        String?
  evidenceBefore String?
  evidenceAfter  String?
  aiJson         Json?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())

  competitor Competitor       @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  source     CompetitorSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([competitorId, createdAt])
  @@index([tenantId])
}

// AI-authored intelligence brief — the "research" layer that a strong model
// (web search) produces on discovery and on a weekly cadence. Separate from
// CompetitorChange (which is the cheap daily page-diff signal).
model CompetitorBrief {
  id           String   @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  competitorId String
  kind         String   @default("research") // research | discovery
  headline     String?
  body         String // markdown-ish plain text briefing
  citations    Json? // [{ title, url }]
  model        String? // model that produced it
  createdById  String? // set when a user triggered it, null for cron
  createdAt    DateTime @default(now())

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId, createdAt])
  @@index([tenantId])
}

// ─── Custom fields (Path A, Phase 2) ─────────────────────────────────
// EAV layer that lets a workspace add its own fields to core objects, so the
// CRM fits non-automotive businesses without code changes. One definition per
// (entity, key); one value per (definition, record). Tenant-agnostic for now
// (single tenant); Phase 4 adds tenant scoping.
model CustomFieldDef {
  id        String   @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  entity    String // contact | lead | quote | case
  key       String // machine key, unique within an entity
  label     String
  type      String   @default("text") // text | textarea | number | date | select | checkbox | url
  options   Json? // string[] for select
  required  Boolean  @default(false)
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values CustomFieldValue[]

  @@unique([entity, key])
  @@index([entity, active, order])
  @@index([tenantId])
  @@unique([tenantId, id])
}

model CustomFieldValue {
  id        String   @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  defId     String
  recordId  String // id of the target contact / lead / quote / case
  value     String? // stored as text; coerced by the field's type on read
  updatedAt DateTime @updatedAt

  def CustomFieldDef @relation(fields: [defId], references: [id], onDelete: Cascade)

  @@unique([defId, recordId])
  @@index([recordId])
  @@index([tenantId])
}

// ── Tenant foundation ─────────────────────────────────────────────────────────
// Multi-tenancy substrate (isolation-first). PR1 is additive + behaviour-
// preserving: one Tenant is seeded for the existing Denago business and every
// current user + session is backfilled into it, so the app runs exactly as
// before. tenantId on data models, tenant-scoped DB access, and role-per-member
// all come in later PRs (see MULTITENANCY-SCOPING.md).

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  active      Boolean  @default(true)
  ownerUserId String?
  /// Module ENTITLEMENT — the optional packs this tenant MAY use, as a CSV of
  /// module ids ("inbox,marketing,automotive"). Granted by a platform admin in the
  /// console. `core` is mandatory and always implied, so it is never stored here.
  ///
  /// This is the OUTER limit, not the effective set: a tenant's own admin may
  /// additionally disable a granted module for themselves (the existing
  /// DISABLED_MODULES AppSetting), but can never enable one that is not granted.
  /// Effective = granted MINUS locally disabled. Empty string = core only, which
  /// is the fail-closed default for a newly created tenant.
  modules     String   @default("")

  /// BRANDING. Every field nullable, and null on ALL of them means "no brand
  /// set", which renders byte-for-byte what the app rendered before branding
  /// existed. Nothing changes for an existing tenant until a platform admin
  /// fills these in — see lib/tenantBrand.ts, which treats a missing brand and a
  /// blank brand identically.
  ///
  /// `brandPrimary` is a plain `#rrggbb` string and is INTERPOLATED INTO A
  /// STYLESHEET, so it is untrusted input at both ends: validated on write, and
  /// validated AGAIN on read, so a value that somehow reached the column cannot
  /// reach the page. The readable text colour is NOT stored — it is computed
  /// from this one's luminance, so a tenant cannot pick white-on-yellow.
  brandPrimary     String?
  /// Blob pathname (not a URL) written through putManagedBlob, resolved at render
  /// time. Storing the path rather than the URL keeps private-mode blobs working.
  brandLogoRef     String?
  /// Replaces the literal "Denago Cape Town" in shells, login pages and documents.
  brandDisplayName String?
  /// Replaces "Authorized Denago EV Dealer" and the login page's tagline copy.
  brandTagline     String?

  createdAt   DateTime @default(now())

  members  TenantMember[]
  sessions UserSession[]
  domains  TenantDomain[]
  owner    User?          @relation("TenantOwner", fields: [ownerUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([active])
  @@index([ownerUserId])
}

/// A hostname that serves one tenant's white-labelled app.
///
/// SEPARATE TABLE, not a column on Tenant, because a white-label tenant has
/// SEVERAL hostnames — the platform-issued one, their own custom domain, and
/// usually apex plus www — each with its own verification state. A single
/// `Tenant.domain` column cannot express that, and retrofitting it later means a
/// migration on live routing.
///
/// THIS IS THE PRE-AUTH TENANT SIGNAL. The login pages have no session, no
/// contact and no token, so the hostname is the only thing that identifies a
/// tenant before anyone signs in. That makes this table an AUTHORIZATION-shaped
/// record even though it only decides branding today: whoever owns the row owns
/// what is rendered at that address.
///
/// `verifiedAt` is therefore load-bearing and lookups MUST require it. Without
/// it a tenant could claim a hostname they do not control and have the platform
/// serve their brand on it. `hostname` is globally unique for the same reason —
/// one address, one tenant, enforced by the database rather than by a check.
model TenantDomain {
  id         String    @id @default(cuid())
  tenantId   String
  /// Lower-cased, port- and protocol-free. Normalised by normaliseHost() before
  /// both write and lookup so "ACME.co.za:443" and "acme.co.za" cannot become two
  /// rows pointing at different tenants.
  hostname   String    @unique
  /// Null until the domain is proven. A null here must never resolve.
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model TenantMember {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String   @unique
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
}

/// Ledger of backup runs, for the platform console's health view.
///
/// Previously the only trace of a backup was the newest blob in storage plus a
/// single BACKUP_LAST_RESULT setting holding the last outcome. Neither records
/// HISTORY, and neither can distinguish "ran and failed" from "never started" —
/// a crashed run looked identical to a quiet one.
///
/// A row is created when a run STARTS (status "running") and updated when it
/// finishes. A row left in "running" long after its startedAt is therefore itself
/// the signal that a run died, which silence could never tell you.
///
/// Deliberately has NO `tenantId`, and is listed in GLOBAL_MODELS. Backups are
/// platform-wide — `exportAllData` dumps the whole database — so every row would
/// carry a null tenant. A nullable tenantId here would be worse than none: the
/// tenant guard would classify the model as tenant-scoped and the enforcement
/// preflight would hard-fail on every null row. Add the column (and remove the
/// GLOBAL_MODELS entry) in the same change that makes backups per-tenant, not
/// before.
model BackupRun {
  id         String    @id @default(cuid())
  status     String    @default("running") // running | success | failed
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?
  sizeBytes  Int?
  blobPath   String?
  /// Failure message, truncated. Null on success.
  error      String?
  /// Non-fatal problems (e.g. assets that could not be snapshotted).
  degraded   Boolean   @default(false)

  @@index([startedAt])
  @@index([status, startedAt])
}

// Platform-admin identity — DELIBERATELY OUTSIDE the tenant model, and listed in
// GLOBAL_MODELS so the tenant guard never tries to scope it.
//
// These tables make the /platform console independent of any tenant, the founding
// Denago Cape Town tenant included. A PlatformAdmin is NOT a `User`, holds NO
// `TenantMember` row, and authenticates through its own login (/platform/login)
// with its own cookie. Consequences: suspending any tenant cannot lock the
// platform operator out, and a compromised CRM session grants no console access.
//
// They intentionally have NO tenantId: a cross-tenant administrator that belonged
// to a tenant would be a contradiction.

/// A platform super-administrator. Created only by the `create-platform-admin`
/// CLI — there is intentionally no self-service signup, since a "create the first
/// admin" page is a takeover vector the moment it misfires.
model PlatformAdmin {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  passwordHash      String
  totpSecret        String? // encrypted TOTP secret; null until enrolled — the LIVE factor
  /// Encrypted secret for an authenticator being enrolled, not yet trusted.
  ///
  /// Without this, beginning an enrolment overwrites the live secret and clears
  /// `totpEnabledAt` — a working 2FA disable for anyone holding a session, and a
  /// Server Action is a POST endpoint reachable without the console screen that
  /// renders the button. Disabling demands a current code precisely so a stolen
  /// session cannot strip the factor and survive a password rotation; enrolling
  /// walked around that guard. On an account with no administrator above it,
  /// that is the difference between a contained incident and a permanent one.
  ///
  /// Promoted to `totpSecret` only once a code proves the new authenticator
  /// holds it. Nothing authenticates against this column.
  totpPendingSecret String?
  totpEnabledAt     DateTime?
  /// JSON array of bcrypt-hashed one-time backup codes, as on User.
  ///
  /// Not optional for this account in the way it nearly is for a CRM user. A
  /// tenant user who loses their authenticator asks an owner to reset it; a
  /// platform admin has nobody above them, so the only recovery is an UPDATE
  /// against the production database by hand. Codes are issued at enrolment and
  /// each one is consumed on use.
  totpBackupCodes   String?
  disabledAt        DateTime? // locks the account out without deleting it
  sessionVersion    Int       @default(0) // bump to revoke every existing session
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())

  sessions PlatformAdminSession[]

  @@index([disabledAt])
}

/// Session registry for platform admins — the server-side half of the cookie, so
/// a session can be revoked remotely rather than merely expiring.
model PlatformAdminSession {
  id           String    @id @default(cuid())
  jti          String    @unique // matches the jti claim inside the platform JWT
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?

  adminId String
  admin   PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([revokedAt])
}

// Phase C step 2b (C2) — per-tenant PUBLIC API keys, replacing the single global
// INTAKE_API_KEY for intake / bookings / service-lookup. Keys are HASHED at rest
// (sha256 of the raw key; the raw key is shown once at creation). Scalar tenantId
// (no FK), matching the Phase B additive convention — resolution is app-layer, and
// a dangling key simply fails to resolve (fail closed). Inert until the routes
// consume it; the legacy global key keeps working (dormant back-compat).
model TenantApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  label      String
  hashedKey  String    @unique // sha256(rawKey) hex
  prefix     String // first chars of the raw key, for display only
  scopes     String    @default("intake,bookings,service-lookup") // csv of allowed scopes
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([tenantId])
}

// Inbound channel endpoint → owning tenant (Phase C 2b-C3). One row per external
// endpoint WE own — a WhatsApp business phone-number id, a Facebook Page id, an
// Instagram account id. The webhook reads the discriminator out of the payload and
// resolves the tenant BEFORE any scope exists (resolveChannelTenant, raw SQL via
// basePrisma — same pre-scope infra boundary as TenantApiKey / the token resolvers).
// Scalar tenantId, NO hard FK, matching the TenantApiKey convention: resolution is
// app-layer and JOINs Tenant + requires active=true, so a mapping to a missing OR
// SUSPENDED tenant simply fails to resolve (a plain FK would allow a suspended
// tenant through — the active check is required regardless, and subsumes the FK).
// DORMANT until enforcement; additive, resolved only on webhook paths.
model ChannelIdentity {
  id         String    @id @default(cuid())
  tenantId   String
  channel    String // "whatsapp" | "messenger" | "instagram"
  externalId String // the stable id of OUR endpoint, not the sender (see design §2.3)
  label      String? // human note e.g. "Denago main WABA"
  createdAt  DateTime  @default(now())
  disabledAt DateTime?

  @@unique([channel, externalId]) // one endpoint belongs to exactly one tenant
  @@index([tenantId])
}
