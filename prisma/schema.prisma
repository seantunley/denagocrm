generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  passwordHash      String
  role              String    @default("member") // owner | member
  modules           String    @default("crm,workshop,reports,inbox") // gated modules, csv
  totpSecret        String? // encrypted TOTP secret
  totpEnabledAt     DateTime?
  totpBackupCodes   String? // JSON array of bcrypt-hashed one-time backup codes
  sessions          UserSession[]
  passkeys          Passkey[]
  emailOtpEnabled   Boolean   @default(false)
  loginOtpHash      String? // hashed email login code
  loginOtpExpires   DateTime?
  passwordChangedAt DateTime?
  mobile            String?
  signatureHtml     String? // custom override; blank = branded template
  drawnSignatureRef String? // saved handwritten signature for countersigning documents
  createdAt         DateTime  @default(now())

  communications     Communication[]
  documents          Document[]
  serviceRecords     ServiceRecord[]
  leadsAssigned      Lead[]
  leadsCreated       Lead[]           @relation("LeadCreator")
  contactsOwned      Contact[]        @relation("ContactOwner")
  contactsCreated    Contact[]        @relation("ContactCreator")
  activitiesAssigned Activity[]       @relation("ActivityAssignee")
  activitiesCreated  Activity[]       @relation("ActivityCreator")
  libraryVersions    LibraryVersion[]
  quotesCreated      Quote[]          @relation("QuoteCreator")
  jobCardsAsTech     JobCard[]        @relation("JobCardTechnician")
  jobCardTimeEntries JobCardTimeEntry[] @relation("JobCardTimeTechnician")
  campaignsCreated   Campaign[]       @relation("CampaignCreator")
}

model AppSetting {
  key   String @id
  value String
}

// Company document library (brochures, price lists) with version control
model LibraryDocument {
  id        String   @id @default(cuid())
  name      String
  category  String? // Brochure | Price list | Spec sheet | Other
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt     DateTime?
  deletedByName String?
  deleteReason  String?

  versions LibraryVersion[]
}

model LibraryVersion {
  id         String   @id @default(cuid())
  version    Int
  fileName   String
  storedName String
  mimeType   String
  sizeBytes  Int
  note       String? // what changed in this version
  createdAt  DateTime @default(now())

  documentId   String
  document     LibraryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User            @relation(fields: [uploadedById], references: [id])

  @@unique([documentId, version])
}

model Product {
  id             String   @id @default(cuid())
  name           String
  sku            String?
  category       String?
  basePriceCents Int      @default(0)
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  deletedAt     DateTime?
  deletedByName String?
  deleteReason  String?

  colors     ProductColor[]
  leads      Lead[]
  vehicles   Vehicle[]
  stockUnits StockUnit[]
  quoteItems QuoteItem[]
}

model PurchaseOrder {
  id         String      @id @default(cuid())
  reference  String? // supplier's PO / order number
  supplier   String      @default("Denago")
  status     String      @default("ordered") // ordered | received | cancelled
  orderedAt  DateTime    @default(now())
  expectedAt DateTime?
  notes      String?
  createdAt  DateTime    @default(now())
  deletedAt  DateTime?
  units      StockUnit[]
}

model StockUnit {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id])
  color     String?
  serial    String? // VIN / serial number
  status    String    @default("incoming") // incoming | available | reserved | sold
  costCents Int       @default(0)
  notes     String?
  createdAt DateTime  @default(now())
  arrivedAt DateTime?
  soldAt    DateTime?
  deletedAt DateTime?

  purchaseOrderId   String?
  purchaseOrder     PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  reservedForLeadId String?
  reservedForLead   Lead?          @relation("StockReserved", fields: [reservedForLeadId], references: [id], onDelete: SetNull)
  soldQuoteId       String?
  soldQuote         Quote?         @relation("StockSold", fields: [soldQuoteId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([productId])
}

model ProductColor {
  id        String  @id @default(cuid())
  name      String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Contact {
  id            String   @id @default(cuid())
  isCompany     Boolean  @default(false)
  firstName     String
  lastName      String?
  company       String?
  email         String?
  phone         String?
  whatsapp      String?
  referralCode  String?  @unique // customer's shareable referral code
  messengerPsid String?  @unique // Facebook Messenger page-scoped id
  instagramId   String?  @unique // Instagram-scoped user id
  address       String? // street address / estate + unit
  suburb        String?
  city          String?
  province      String?
  postalCode    String?
  source          String?
  notes           String?
  marketingOptOut Boolean @default(false) // excluded from bulk campaigns
  research        String? // latest AI research briefing (shown in the Research tab)
  researchedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deletedAt     DateTime?
  deletedByName String?
  deleteReason  String?

  ownerId     String?
  owner       User?   @relation("ContactOwner", fields: [ownerId], references: [id])
  createdById String?
  createdBy   User?   @relation("ContactCreator", fields: [createdById], references: [id])

  leads             Lead[]
  communications    Communication[]
  conversations     Conversation[]
  referralsMade     Referral[]      @relation("ReferralsMade")
  referredIn        Referral[]      @relation("ReferredIn")
  documents         Document[]
  vehicles          Vehicle[]
  jobCards          JobCard[]
  activities        Activity[]
  tags              Tag[]
  quotes            Quote[]
  researchNotes     ResearchNote[]
  campaignRecipients CampaignRecipient[]
  consentRecords    ConsentRecord[]
}

// POPIA consent ledger — an append-only history of consent given/withdrawn,
// so we can prove lawful basis for holding and marketing to a person.
model ConsentRecord {
  id          String   @id @default(cuid())
  type        String // marketing | service | data_processing
  granted     Boolean
  source      String? // form | phone | email | import | admin
  note        String?
  createdAt   DateTime @default(now())
  createdById String?

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  color    String    @default("#64748b")
  contacts Contact[]
}

model Campaign {
  id             String    @id @default(cuid())
  name           String
  channel        String // email | sms
  subject        String?
  body           String // plain-text (SMS body, or text fallback for email)
  htmlBody       String? // rich HTML for email campaigns
  audience       String // human-readable audience label
  recipientCount Int       @default(0)
  sentCount      Int       @default(0)
  failedCount    Int       @default(0)
  openCount      Int       @default(0) // unique recipients who opened
  clickCount     Int       @default(0) // unique recipients who clicked
  status         String    @default("draft") // draft | queued | sending | sent
  createdAt      DateTime  @default(now())
  sentAt         DateTime?
  createdById    String?
  createdBy      User?     @relation("CampaignCreator", fields: [createdById], references: [id])
  recipients     CampaignRecipient[]

  @@index([status])
}

model CampaignRecipient {
  id         String    @id @default(cuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  token      String    @unique // tracking/unsubscribe token
  status     String    @default("queued") // queued | sent | failed
  sentAt     DateTime?
  openedAt   DateTime?
  openCount  Int       @default(0)
  clickedAt  DateTime?
  clickCount Int       @default(0)
  error      String?

  @@index([campaignId])
  @@index([status])
}

model Segment {
  id        String   @id @default(cuid())
  name      String
  criteria  String // JSON: { source?, tagId?, hasVehicle?, serviceDue?, province?, wonOnly? }
  createdAt DateTime @default(now())
}

/** A saved chatbot conversation flow (one can be marked active/live). */
model BotFlow {
  id         String   @id @default(cuid())
  name       String
  channel    String   @default("whatsapp")
  active     Boolean  @default(false)
  definition String // JSON { start, nodes, positions }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt @default(now())
}

/** Live state of a customer's position in a chatbot flow. */
model BotSession {
  id        String   @id @default(cuid())
  channel   String   @default("whatsapp")
  key       String // phone digits (or web visitor id)
  nodeId    String? // current waiting node
  vars      String   @default("{}") // captured variables, JSON
  status    String   @default("active") // active | paused
  updatedAt DateTime @updatedAt @default(now())
  expiresAt DateTime

  @@unique([channel, key])
}

model PipelineStage {
  id    String @id @default(cuid())
  name  String
  order Int
  color String @default("#64748b")

  leads Lead[]
}

model Lead {
  id         String  @id @default(cuid())
  title      String
  name       String
  email      String?
  phone      String?
  source     String  @default("manual") // manual | facebook | instagram | website
  color      String? // colour of interest for the product
  notes      String?
  quantity   Int     @default(1) // number of carts wanted (drives the value)
  valueCents Int     @default(0)
  status     String  @default("open") // open | won | lost
  lostReason String?
  position   Int     @default(0)
  externalId String? @unique // e.g. Facebook leadgen_id
  raw        String? // raw intake payload (JSON string)

  research     String? // latest AI research briefing (shown in the Research tab)
  researchedAt DateTime?
  viewedAt     DateTime? // first time a staff member opened the lead
  stageEnteredAt DateTime @default(now()) // when it landed in the current stage (stale-age flag)

  deletedAt     DateTime?
  deletedByName String?
  deleteReason  String?

  stageId      String
  stage        PipelineStage @relation(fields: [stageId], references: [id])
  productId    String?
  product      Product?      @relation(fields: [productId], references: [id])
  contactId    String?
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   User?         @relation(fields: [assignedToId], references: [id])
  createdById  String?
  createdBy    User?         @relation("LeadCreator", fields: [createdById], references: [id])

  communications Communication[]
  conversations  Conversation[]
  activities     Activity[]
  quotes         Quote[]
  researchNotes  ResearchNote[]
  reservedStock  StockUnit[]    @relation("StockReserved")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  referral  Referral?
}

model ResearchNote {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([contactId])
}

model Activity {
  id             String    @id @default(cuid())
  type           String    @default("todo") // call | email | meeting | whatsapp | todo
  category       String? // null/sales = sales calendar, "workshop" = workshop calendar
  summary        String
  note           String?
  location       String? // meeting place - opens in Google Maps
  reminderSentAt DateTime? // hour-before push already sent
  dueDate        DateTime
  status         String    @default("planned") // planned | done | canceled
  doneAt         DateTime?

  leadId       String?
  lead         Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId    String?
  contact      Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedToId String
  assignedTo   User     @relation("ActivityAssignee", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User     @relation("ActivityCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
}

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String
  subject   String
  body      String
  createdAt DateTime @default(now())
}

model AutomationRule {
  id     String  @id @default(cuid())
  name   String
  active Boolean @default(true)

  trigger        String // lead_created | stage_entered | lead_idle | lead_won | lead_lost | quote_signed | quote_declined | delivered | referral_earned
  triggerStageId String? // for stage_entered
  idleDays       Int? // for lead_idle

  // Optional conditions - rule only fires when they hold
  conditionSources String? // csv of lead sources, empty = any
  minValueCents    Int? // minimum lead value

  action          String // create_activity | send_email | move_stage | assign_user
  activityType    String?
  activitySummary String?
  activityDueDays Int?
  emailTemplateId String?
  targetStageId   String?
  assignToId      String?
  pushMessage     String? // for send_push

  createdAt DateTime @default(now())
}

model Quote {
  id         String    @id @default(cuid())
  number     Int       @unique
  status     String    @default("draft") // draft | sent | accepted | declined
  validUntil DateTime?
  terms      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  deletedAt     DateTime?
  deletedByName String?
  deleteReason  String?

  signToken            String?   @unique
  signedAt             DateTime?
  signedByName         String?
  signatureRef         String?
  signerIp             String?
  signerUserAgent      String?
  signedPdfHash        String? // SHA-256 of the filed signed PDF (tamper evidence)
  signLinkCreatedAt    DateTime?
  viewedAt             DateTime? // first time the customer opened the signing link
  declinedAt           DateTime?
  declineReason        String?
  reminderSentAt       DateTime? // unsigned-quote nudge already sent
  // Fulfilment flow after signing (all set manually from the Deliveries board)
  invoicedAt           DateTime?
  depositPaidAt        DateTime?
  deliveryScheduledFor DateTime?
  deliveredAt          DateTime?
  deliveredByName      String? // driver / who handed the cart over
  deliveryChecklist    Json? // handover checklist { item: boolean }
  deliverySignatureRef String? // stored PNG of the customer's on-handover signature
  dealerSignedAt       DateTime?
  dealerSignedByName   String?
  dealerSignatureRef   String?

  // Version control: a revision points at the quote it replaces; the old one
  // is stamped superseded and becomes read-only.
  changeRequestedAt DateTime?
  changeRequestNote String?
  revisionOfId      String?
  revisionOf        Quote?    @relation("QuoteRevisions", fields: [revisionOfId], references: [id], onDelete: SetNull)
  revisions         Quote[]   @relation("QuoteRevisions")
  supersededAt      DateTime?

  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?    @relation("QuoteCreator", fields: [createdById], references: [id])

  items     QuoteItem[]
  soldStock StockUnit[] @relation("StockSold")
}

model QuoteItem {
  id             String @id @default(cuid())
  description    String
  qty            Float  @default(1)
  unitPriceCents Int    @default(0)
  discountPct    Float  @default(0)
  colorPreference String?

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ServiceReminderLog {
  id        String   @id @default(cuid())
  vehicleId String
  dueKey    String // identifies the due-cycle so each service due is reminded once
  sentTo    String
  createdAt DateTime @default(now())

  @@unique([vehicleId, dueKey])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String
  userName  String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String // e.g. contact.created, lead.stage_changed, jobcard.completed
  summary   String // human-readable: what was done
  contactId String? // the customer this relates to
  leadId    String?
  userId    String?
  userName  String // denormalized so history survives user changes
  createdAt DateTime @default(now())

  @@index([contactId, createdAt])
  @@index([leadId, createdAt])
}

model AutomationLog {
  id        String   @id @default(cuid())
  ruleId    String
  leadId    String
  note      String?
  createdAt DateTime @default(now())

  @@index([ruleId, leadId])
}

model Communication {
  id             String   @id @default(cuid())
  type           String // call | email | whatsapp | meeting | note
  direction      String? // inbound | outbound
  subject        String?
  body           String
  attachmentUrl  String? // stored media (image/audio/video/file)
  attachmentType String? // image | audio | video | file
  occurredAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  // Shared-inbox threading (Phase 1)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messageId      String? // provider Message-ID (email) / platform message id
  inReplyTo      String? // email In-Reply-To header
  references     String? // email References chain (space-separated Message-IDs)
  readAt         DateTime? // when staff first opened the conversation carrying this inbound message

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@index([conversationId])
  @@index([messageId])
}

/// A shared-inbox conversation: groups related messages with a contact (or lead)
/// on a single channel. Foundation for assignment, unread and SLA reporting.
model Conversation {
  id              String    @id @default(cuid())
  channel         String // email | whatsapp | messenger | instagram | call | note | other
  subject         String?
  status          String    @default("open") // open | snoozed | closed
  unread          Boolean   @default(false) // has un-opened inbound messages
  lastMessageAt   DateTime  @default(now())
  lastInboundAt   DateTime?
  firstResponseAt DateTime? // first outbound after an inbound — foundation for response-time reporting
  messageCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  contactId String?
  contact   Contact?        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages  Communication[]

  @@index([status, lastMessageAt])
  @@index([unread, lastMessageAt])
  @@index([contactId])
  @@index([leadId])
}

model Document {
  id         String   @id @default(cuid())
  fileName   String
  storedName String   @unique
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  deletedAt     DateTime?
  deletedByName String?
  deleteReason  String?

  contactId    String?
  contact      Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  vehicleId    String?
  vehicle      Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  jobCardId    String?
  jobCard      JobCard? @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  quoteId      String? // fulfilment paperwork (invoice, proof of payment, delivery note)
  tag          String? // invoice | pop | delivery-note
  replacedById String? // newer version of this file (repository versioning)
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
}

model Vehicle {
  id                    String    @id @default(cuid())
  model                 String
  vin                   String?   @unique
  regNumber             String?
  color                 String?
  purchaseDate          DateTime?
  warrantyMonths        Int?
  serviceIntervalKm     Int?      @default(1000)
  serviceIntervalMonths Int?      @default(6)
  notes                 String?
  createdAt             DateTime  @default(now())

  deletedAt     DateTime?
  deletedByName String?
  deleteReason  String?

  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  fleetId   String?
  fleet     Fleet?   @relation(fields: [fleetId], references: [id], onDelete: SetNull)

  mileageLogs    MileageLog[]
  serviceRecords ServiceRecord[]
  jobCards       JobCard[]
  documents      Document[]
  batteryChecks  BatteryCheck[]
  warrantyClaims WarrantyClaim[]

  @@index([fleetId])
}

// A fleet / B2B account — an estate, golf course, resort or business that
// owns many carts. Groups vehicles for a fleet-level service overview.
model Fleet {
  id          String    @id @default(cuid())
  name        String
  type        String? // estate | golf-course | resort | business | other
  notes       String?
  contactId   String? // primary contact / fleet manager
  createdAt   DateTime  @default(now())
  createdById String?
  deletedAt   DateTime?

  vehicles Vehicle[]
}

// A warranty claim against a cart. Lightweight workflow: open → approved/
// rejected → resolved, with a free-text resolution note.
model WarrantyClaim {
  id          String    @id @default(cuid())
  status      String    @default("open") // open | approved | rejected | resolved
  description String
  resolution  String?
  claimedAt   DateTime  @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  vehicleId   String
  vehicle     Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  contactId   String?
  jobCardId   String?
  createdById String?

  @@index([status, claimedAt])
  @@index([vehicleId])
}

// A recall or service bulletin for a cart model. Owners of matching carts can
// be notified in one click.
model Recall {
  id          String    @id @default(cuid())
  title       String
  model       String // affected cart model (matches Vehicle.model)
  description String
  active      Boolean   @default(true)
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  createdById String?

  @@index([active])
}

// EV battery health snapshots — track state-of-health, voltage and charge
// cycles over time so degradation is visible and replacement conversations
// happen proactively (the battery is a cart's most expensive component).
model BatteryCheck {
  id            String   @id @default(cuid())
  checkedAt     DateTime @default(now())
  packSerial    String?
  stateOfHealth Int? // % of original capacity
  voltage       Float? // resting pack voltage
  cycles        Int? // charge cycles
  notes         String?
  createdAt     DateTime @default(now())

  vehicleId    String
  vehicle      Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  jobCardId    String?
  recordedById String? // user who logged it (loose pointer)

  @@index([vehicleId, checkedAt])
}

model MileageLog {
  id         String   @id @default(cuid())
  km         Int
  recordedAt DateTime @default(now())
  note       String?

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model ServiceRecord {
  id          String    @id @default(cuid())
  serviceDate DateTime  @default(now())
  km          Int?
  summary     String
  details     String?
  nextDueKm   Int?
  nextDueDate DateTime?
  createdAt   DateTime  @default(now())

  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  jobCardId     String?  @unique
  jobCard       JobCard? @relation(fields: [jobCardId], references: [id])
  performedById String?
  performedBy   User?    @relation(fields: [performedById], references: [id])
}

model JobCard {
  id          String    @id @default(cuid())
  number      Int       @unique
  // Workshop stages: booking | checkin | diagnosis | approval | repair | qc | ready | collected | cancelled
  status      String    @default("booking")
  description String
  kmIn        Int?
  openedAt    DateTime  @default(now())
  completedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Workshop depth (phase 1)
  priority        String @default("normal") // low | normal | high | urgent
  estimatedHours  Float?
  labourRateCents Int? // per-job override; falls back to the workshop default setting
  bayId           String?
  bay             WorkshopBay? @relation(fields: [bayId], references: [id], onDelete: SetNull)

  // Workshop depth (phase 2): condition notes at check-in / check-out
  checkinNotes  String?
  checkoutNotes String?

  // Workshop depth (phase 3): subcontracting
  isSubcontracted Boolean @default(false)
  subcontractor   String?
  subCostCents    Int     @default(0)

  deletedAt     DateTime?
  deletedByName String?
  deleteReason  String?

  signToken       String?   @unique
  signedAt        DateTime?
  signedByName    String?
  signatureRef    String?
  signerIp        String?
  signerUserAgent String?
  signedPdfHash   String?
  viewedAt        DateTime?

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  technicianId String?
  technician   User?   @relation("JobCardTechnician", fields: [technicianId], references: [id])

  items           JobCardItem[]
  serviceRecord   ServiceRecord?
  documents       Document[]
  timeEntries     JobCardTimeEntry[]
  inspectionItems JobCardInspectionItem[]
  approvals       JobCardApproval[]
  reservations    PartReservation[]

  @@index([bayId])
}

model PartReservation {
  id        String   @id @default(cuid())
  qty       Int      @default(1)
  status    String   @default("active") // active | released | consumed
  createdAt DateTime @default(now())

  partId    String
  part      Part    @relation(fields: [partId], references: [id], onDelete: Cascade)
  jobCardId String
  jobCard   JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)

  @@index([partId, status])
  @@index([jobCardId, status])
}

model ServicePackage {
  id          String   @id @default(cuid())
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  items ServicePackageItem[]
}

model ServicePackageItem {
  id             String @id @default(cuid())
  kind           String @default("part") // part | labour
  description    String
  qty            Float  @default(1)
  unitPriceCents Int    @default(0)
  partId         String?

  packageId String
  package   ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
}

model JobCardInspectionItem {
  id             String   @id @default(cuid())
  label          String
  status         String   @default("ok") // ok | attention | fail | na
  notes          String?
  photoStoredName String? // blob URL / filename from saveFile
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  jobCardId String
  jobCard   JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)

  @@index([jobCardId])
}

model JobCardApproval {
  id          String    @id @default(cuid())
  description String
  amountCents Int       @default(0)
  status      String    @default("pending") // pending | approved | declined
  decidedVia  String? // portal | phone | in_person | email
  decidedAt   DateTime?
  notes       String?
  createdById String?
  createdAt   DateTime  @default(now())

  jobCardId String
  jobCard   JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)

  @@index([jobCardId, status])
}

model WorkshopBay {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#0ea5e9")
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  notes     String?
  createdAt DateTime @default(now())

  jobCards JobCard[]
}

model JobCardTimeEntry {
  id        String    @id @default(cuid())
  startedAt DateTime  @default(now())
  endedAt   DateTime? // null while the clock is running
  note      String?
  createdAt DateTime  @default(now())

  jobCardId    String
  jobCard      JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  technicianId String
  technician   User    @relation("JobCardTimeTechnician", fields: [technicianId], references: [id])

  @@index([jobCardId])
  @@index([technicianId, endedAt])
}

model JobCardItem {
  id             String @id @default(cuid())
  kind           String @default("part") // part | labour
  description    String
  qty            Float  @default(1)
  unitPriceCents Int    @default(0)

  jobCardId String
  jobCard   JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  partId    String? // set when the line came from the parts catalogue (stock deducted)
  part      Part?   @relation(fields: [partId], references: [id], onDelete: SetNull)
}

model Part {
  id         String   @id @default(cuid())
  name       String
  sku        String?
  priceCents Int      @default(0) // sell price
  costCents  Int      @default(0) // cost price
  stockQty   Int      @default(0)
  reorderAt  Int? // low-stock threshold
  location   String?
  notes      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  deletedAt  DateTime?

  jobCardItems JobCardItem[]
  reservations PartReservation[]
}

// One-time codes for verifying vehicle owners on the public booking form.
model OtpChallenge {
  id         String    @id @default(cuid())
  purpose    String // e.g. service-booking
  key        String // normalized VIN / serial
  codeHash   String // sha256 of the 6-digit code
  channel    String // sms | email
  target     String // masked destination shown to the customer
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([purpose, key, createdAt])
}

// Google reviews pulled from the Places API (read-only; reply via Google Maps).
model GoogleReview {
  id          String   @id @default(cuid())
  externalKey String   @unique // hash of author + time (Places API has no stable id)
  author      String
  rating      Int
  text        String?
  publishedAt DateTime
  raw         String?
  createdAt   DateTime @default(now())
}

// A customer referred someone. Fee is earned when the referred lead is won,
// and redeemed manually (note records what was given at the time).
model Referral {
  id           String    @id @default(cuid())
  status       String    @default("pending") // pending | earned | redeemed
  earnedAt     DateTime?
  redeemedAt   DateTime?
  redeemedNote String? // e.g. "R1,000 service voucher"
  createdAt    DateTime  @default(now())

  referrerId String
  referrer   Contact  @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  leadId     String?  @unique
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contactId  String? // the referred person once they are a contact
  contact    Contact? @relation("ReferredIn", fields: [contactId], references: [id], onDelete: SetNull)

  @@index([referrerId, createdAt])
}

// Saved list filters ("Facebook leads over R200k this month")
model SavedView {
  id        String   @id @default(cuid())
  name      String
  page      String // e.g. leads
  query     String // URL search params
  createdAt DateTime @default(now())
}

// Monthly business goals — actuals vs target on the KPI dashboard.
model Target {
  id        String   @id @default(cuid())
  metric    String // leads | sales_value | deliveries | services
  period    String // YYYY-MM
  value     Int // target (a count, or cents for sales_value)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([metric, period])
}

// System errors that would otherwise vanish into serverless logs
model ErrorLog {
  id        String   @id @default(cuid())
  scope     String // e.g. imap-sync, meta-webhook, smtp, pdf, unhandled
  message   String
  stack     String?
  context   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Customer feedback surveys — CSAT after a service, NPS, post-sale, or ad-hoc.
// Questions are stored as JSON so new question types need no migration.
model Survey {
  id          String    @id @default(cuid())
  title       String
  type        String    @default("adhoc") // csat | sales | nps | adhoc
  intro       String? // shown at the top of the form / in the invite
  thankYou    String? // shown after submitting
  questions   Json // [{id,type,label,required,options?,scale?}]
  active      Boolean   @default(true)
  trigger     String? // job_complete | delivery | won | null (manual send)
  delayHours  Int       @default(0) // wait this many hours after the trigger before sending
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  responses SurveyResponse[]

  @@index([type, active])
}

// One invite/answer per recipient. contactId/leadId/jobCardId are loose
// pointers (no FK) so this never complicates the core records.
model SurveyResponse {
  id          String    @id @default(cuid())
  token       String    @unique @default(cuid()) // public, unguessable link
  surveyId    String
  survey      Survey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  contactId   String?
  leadId      String?
  jobCardId   String?
  name        String? // recipient name snapshot
  channel     String? // email | sms
  answers      Json? // { questionId: value }
  score        Int? // primary rating (1-5) or NPS (0-10), for rollups
  comment      String? // free-text highlight
  status       String    @default("sent") // scheduled | sent | completed | failed
  scheduledFor DateTime? // set when a delay is configured; cron sends once due
  sentAt       DateTime  @default(now())
  completedAt  DateTime?

  @@index([surveyId, status])
  @@index([contactId])
  @@index([status, scheduledFor])
}

// One row per signed-in device — powers the device log and remote sign-out.
model UserSession {
  id           String    @id @default(cuid())
  jti          String    @unique // matches the jti claim inside the JWT
  platform     String    @default("web") // web | pwa (installed app, 7-day session)
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

// Named, editable document templates — many per type, one default per type.
model DocTemplateRecord {
  id        String    @id @default(cuid())
  docType   String // quote | jobcard | delivery
  name      String
  isDefault Boolean   @default(false)
  config    Json // logo, footer, terms, sections, signature, accent…
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([docType, isDefault])
}

// Block-based document builder: a Puck document tree (blocks + root props) that
// renders to a flowing, multi-page PDF via react-pdf. This is the "control your
// own documents" editor — additive; the live print/signing pipeline is untouched.
model DocBuilderTemplate {
  id              String    @id @default(cuid())
  name            String
  key             String // doc type: quote | invoice | agreement | … | custom
  data            Json // Puck document data ({ content, root, zones }) — the working draft
  isDefault       Boolean   @default(false)
  status          String    @default("draft") // draft | published
  publishedVersion Int? // version number currently published (null = never published)
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Default signing workflow used when this document is sent for signature (overridable at send).
  defaultWorkflowId String?
  defaultWorkflow   SignWorkflow? @relation("TemplateDefaultWorkflow", fields: [defaultWorkflowId], references: [id])

  versions DocBuilderVersion[]

  @@index([key, isDefault])
}

/// A visual signing workflow: an ordered/branching graph of signer + condition
/// nodes that compiles (against a quote/job card) into the hub's recipient chain.
model SignWorkflow {
  id          String    @id @default(cuid())
  name        String
  description String?
  graphJson   Json // { start, nodes: {id: node}, positions: {id: {x,y}} }
  isArchived  Boolean   @default(false)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  templates DocBuilderTemplate[] @relation("TemplateDefaultWorkflow")
}

// Immutable snapshot of a builder template's JSON at publish time. Restore copies
// a version's data back onto the working draft; publish snapshots the draft.
model DocBuilderVersion {
  id          String   @id @default(cuid())
  version     Int
  data        Json // immutable Puck document snapshot
  label       String?
  publishedAt DateTime @default(now())
  publishedBy String?

  templateId String
  template   DocBuilderTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@index([templateId, version])
}

// ── E-signing: unified signature-request hub (all document types) ────
// An envelope wrapping any PDF: recipients act on placed fields; every action is
// logged to SignatureEvent (ECTA-grade audit). Sequential or parallel ordering.
model SignatureRequest {
  id      String @id @default(cuid())
  title   String
  status  String @default("draft") // draft|sent|viewed|in_progress|completed|declined|expired|voided|rejected
  ordering String @default("parallel") // parallel|sequential

  // Workflow runtime — set when driven by a saved signing workflow with approval /
  // branch logic. The graph is frozen at send; currentNodeId is the interpreter position.
  workflowGraphJson Json?
  currentNodeId     String?

  // Source of the document (any/all may be null; the PDF to sign is unsignedPdfRef)
  documentId String?
  quoteId    String?
  jobCardId  String?
  contactId  String?
  templateId String? // DocBuilderTemplate it was generated from, if any

  snapshotJson   Json? // frozen resolved document at send time (what the signer sees)
  unsignedPdfRef String? // storage ref of the PDF sent for signing
  signedPdfRef   String? // storage ref of the sealed, completed PDF
  signedPdfHash  String? // sha-256 of the completed PDF
  signedDocId    String? // Document row of the filed, completed PDF

  message     String? // note shown to recipients
  createdById String?
  sentAt      DateTime?
  completedAt DateTime?
  declinedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  recipients SignatureRecipient[]
  fields     SignatureField[]
  events     SignatureEvent[]
  approvals  ApprovalStep[]

  @@index([status, updatedAt])
  @@index([quoteId])
  @@index([jobCardId])
  @@index([contactId])
}

/// An internal approval gate materialised from a workflow's approval node. A CRM
/// person approves/rejects (decision mode) — signature-mode approvals are handled
/// as approver SignatureRecipients instead. Reject routes down the node's rejected branch.
model ApprovalStep {
  id        String           @id @default(cuid())
  requestId String
  request   SignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  nodeId String // workflow node this step was materialised from
  label  String
  mode   String @default("decision") // decision | signature

  assigneeType   String // staff | role | owner
  assigneeUserId String?
  assigneeRole   String?
  assigneeName   String?
  assigneeEmail  String?

  token String @unique // tokenised email approve/reject links

  status         String    @default("pending") // pending | approved | rejected
  decidedByUserId String?
  decidedByName  String?
  decidedAt      DateTime?
  reason         String?

  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([requestId])
  @@index([status])
}

model SignatureRecipient {
  id        String           @id @default(cuid())
  requestId String
  request   SignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  name  String
  email String?
  phone String? // for WhatsApp / SMS
  role  String  @default("signer") // signer|approver|viewer
  order Int     @default(0) // signing order for sequential
  color String  @default("#2563eb")
  nodeId String? // workflow signer node this recipient was materialised from

  token  String @unique // per-recipient signing token (hex)
  status String @default("pending") // pending|sent|viewed|signed|declined

  signedAt        DateTime?
  signedName      String?
  signatureRef    String? // PNG of their drawn/typed signature
  viewedAt        DateTime?
  declinedAt      DateTime?
  declineReason   String?
  signerIp        String?
  signerUserAgent String?
  remindedAt      DateTime?

  fields SignatureField[]

  @@index([requestId, order])
}

model SignatureField {
  id        String           @id @default(cuid())
  requestId String
  request   SignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  recipientId String?
  recipient   SignatureRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  kind     String // signature|initials|date|text|checkbox|radio|dropdown|attachment|stamp
  page     Int
  x        Float
  y        Float
  width    Float
  height   Float
  required Boolean @default(true)
  label    String  @default("")

  value    String? // captured text / signature ref / "true"
  filledAt DateTime?

  @@index([requestId])
}

// Append-only audit trail — never updated or deleted.
model SignatureEvent {
  id        String           @id @default(cuid())
  requestId String
  request   SignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  recipientId String?
  type        String // created|sent|delivered|opened|viewed|field_filled|signed|declined|completed|reminded|downloaded|voided
  actor       String // "Denago: <name>" | recipient name | "system"
  channel     String? // email|whatsapp|sms|in_person|web
  ip          String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([requestId, createdAt])
}

// ── Document Studio: free-form BlockNote documents ──────────────────
// Templates hold draft JSON; publishing snapshots an immutable version.
model CustomDocTemplate {
  id          String    @id @default(cuid())
  name        String
  description String?
  draftJson   Json // current editable BlockNote content
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  versions  CustomDocVersion[]
  instances DocInstance[]
}

model CustomDocVersion {
  id          String   @id @default(cuid())
  version     Int
  contentJson Json // immutable snapshot
  publishedAt DateTime @default(now())
  publishedBy String?

  templateId String
  template   CustomDocTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
}

// A generated document: owns an editable copy + the resolved-data snapshot.
model DocInstance {
  id           String    @id @default(cuid())
  title        String
  status       String    @default("draft") // draft | final
  contentJson  Json // editable copy (tokens resolved at creation)
  snapshotJson Json? // resolved CRM data at generation time
  contactId    String?
  leadId       String?
  quoteId      String?
  pdfDocId     String? // Document row of the last generated PDF
  createdById  String?
  finalizedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  templateVersionId String?
  templateId        String?
  template          CustomDocTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
}

// Reusable clauses — inserted BY VALUE into documents (no dependency graph).
model ReusableBlock {
  id          String    @id @default(cuid())
  name        String
  category    String?
  contentJson Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

// WebAuthn passkeys — biometric / device sign-in (Phase 2 auth).
model Passkey {
  id           String    @id @default(cuid())
  credentialId String    @unique // base64url credential ID
  publicKey    Bytes // COSE public key
  counter      BigInt    @default(0)
  transports   String? // csv: internal,hybrid,usb…
  nickname     String? // "Sean's iPhone"
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
