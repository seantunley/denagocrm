model Communication {
  id             String   @id @default(cuid())
  type           String // call | email | whatsapp | meeting | note
  direction      String? // inbound | outbound
  subject        String?
  body           String
  attachmentUrl  String? // stored media (image/audio/video/file)
  attachmentType String? // image | audio | video | file
  occurredAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  // Shared-inbox threading (Phase 1)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messageId      String? // provider Message-ID (email) / platform message id
  // Idempotency key for inbound-email filing: the Message-ID, or a content hash
  // when the mail has none. Unique so a retried/overlapping IMAP run can't file
  // the same email onto the timeline twice. (messageId keeps only a plain index
  // and may legitimately repeat across historical rows, so it can't be the key.)
  dedupeKey      String? @unique
  inReplyTo      String? // email In-Reply-To header
  references     String? // email References chain (space-separated Message-IDs)
  readAt         DateTime? // when staff first opened the conversation carrying this inbound message
  /// The customer's side of an OUTBOUND message: when the platform reported it
  /// delivered to their device, and when they opened it. Distinct from `readAt`,
  /// which is about OUR staff opening THEIR message — the two look alike and mean
  /// opposite things. Both are watermark-derived; see lib/deliveryReceipts.ts.
  deliveredAt    DateTime?
  seenAt         DateTime?
  archivedAt     DateTime? // when the thread carrying this message was archived out of the inbox (NULL = active)

  // Multi-tenancy (Phase B — additive/inert): owning tenant. See Contact.tenantId.
  tenantId  String?

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@index([conversationId])
  @@index([messageId])
  @@index([archivedAt])
  @@index([tenantId])
}

/// A shared-inbox conversation: groups related messages with a contact (or lead)
/// on a single channel. Foundation for assignment, unread and SLA reporting.
model Conversation {
  id              String    @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  channel         String // email | whatsapp | messenger | instagram | call | note | other
  subject         String?
  status          String    @default("open") // open | snoozed | closed
  unread          Boolean   @default(false) // has un-opened inbound messages
  lastMessageAt   DateTime  @default(now())
  lastInboundAt   DateTime?
  firstResponseAt DateTime? // first outbound after an inbound — foundation for response-time reporting
  messageCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // inbound | outbound. 'inbound' means the last word was the customer's, which
  // is the only cheap way to ask "is anyone waiting on us?" without loading the
  // messages — `unread` answers a different question (nobody has LOOKED), and a
  // thread can be read and still unanswered.
  lastDirection String?

  // Assignment is what turns a shared inbox into a worklist: without it, "who is
  // dealing with this?" is answered by asking the room.
  assignedToId String?
  assignedTo   User?     @relation("ConversationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedAt   DateTime?

  contactId String?
  contact   Contact?        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages  Communication[]
  notes     ConversationNote[]
  draft     ConversationDraft?

  @@index([status, lastMessageAt])
  @@index([unread, lastMessageAt])
  @@index([contactId])
  @@index([leadId])
  @@index([tenantId])
  @@index([lastDirection, lastMessageAt])
  @@index([assignedToId, status])
  @@unique([tenantId, id])
}

/**
 * A staff-only note on a conversation. NEVER sent to the customer.
 *
 * The point is that the handover context ("promised him a callback Tuesday, waiting
 * on stock") lives beside the thread instead of in someone's head, so whoever picks
 * the conversation up next has it.
 */
model ConversationNote {
  id             String       @id @default(cuid())
  // Multi-tenancy (Phase B — additive/inert): owning tenant. See Contact.tenantId.
  tenantId       String?
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation("ConversationNoteAuthor", fields: [authorId], references: [id])
  body           String
  mentions       String[] // user ids named with @ — stored so a notifier can read them
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([tenantId])
}

/**
 * The in-progress reply for a conversation — one per conversation, with an owner.
 *
 * A shared inbox's characteristic failure is two people answering the same customer
 * at once. Holding the draft server-side with an owner and a timestamp makes that
 * visible before it happens rather than after the second reply has been sent.
 */
model ConversationDraft {
  id             String       @id @default(cuid())
  // Multi-tenancy (Phase B — additive/inert): owning tenant. See Contact.tenantId.
  tenantId       String?
  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  ownerId        String
  owner          User         @relation("ConversationDraftOwner", fields: [ownerId], references: [id])
  body           String       @default("")
  updatedAt      DateTime     @updatedAt
  createdAt      DateTime     @default(now())

  @@index([tenantId])
}

model Document {
  id         String   @id @default(cuid())
  fileName   String
  storedName String   @unique
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  // Multi-tenancy (Phase B — additive/inert): owning tenant. See Contact.tenantId.
  tenantId   String?

  deletedAt     DateTime?
  deletedByName String?
  deleteReason  String?

  contactId    String?
  contact      Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  vehicleId    String?
  vehicle      Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  jobCardId    String?
  jobCard      JobCard? @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  quoteId      String? // fulfilment paperwork (invoice, proof of payment, delivery note)
  tag          String? // invoice | pop | delivery-note
  replacedById String? // newer version of this file (repository versioning)

  // Re-editable image markup (job-card check-in photos): vector shapes so the
  // markup can be reopened and adjusted; annotatedStoredName is the flattened
  // image with the markup burned in, used for display / print / PDF.
  annotations         Json?
  annotatedStoredName String?

  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])

  @@index([tenantId])
  @@unique([tenantId, id])
}

model Vehicle {
  id                    String    @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  model                 String
  vin                   String?   @unique
  regNumber             String?
  color                 String?
  purchaseDate          DateTime?
  warrantyMonths        Int?
  serviceIntervalKm     Int?      @default(1000)
  serviceIntervalMonths Int?      @default(6)
  notes                 String?
  createdAt             DateTime  @default(now())

  deletedAt     DateTime?
  deletedByName String?
  deleteReason  String?

