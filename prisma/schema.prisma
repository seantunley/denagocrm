  templateId String
  template   DocBuilderTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@index([templateId, version])
  @@index([tenantId])
}

// ── E-signing: unified signature-request hub (all document types) ────
// An envelope wrapping any PDF: recipients act on placed fields; every action is
// logged to SignatureEvent (ECTA-grade audit). Sequential or parallel ordering.
model SignatureRequest {
  id      String @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  title   String
  status  String @default("draft") // draft|sent|viewed|in_progress|completed|declined|expired|voided|rejected
  ordering String @default("parallel") // parallel|sequential

  /// How hard a signer has to prove they are the intended recipient.
  ///
  ///   link      possession of the emailed URL is enough (the historic behaviour)
  ///   email_otp a one-time code sent to the email address on file
  ///   sms_otp   a one-time code sent to the mobile number on file
  ///   otp       a code to either, whichever the signer still has access to
  ///
  /// Defaults to `link` so nothing about existing documents changes and no
  /// customer is met with a step they were never told about. Turning it on is a
  /// per-document choice made when the document is prepared: worth it for a
  /// contract, needless friction for a delivery note.
  ///
  /// It is deliberately NOT forced on globally. A forwarded email, a shared
  /// inbox or a mail-scanning proxy can all open a link-only document, so the
  /// step-up is a real improvement — but which documents are worth asking a
  /// customer for a code is a business judgement, not a security default.
  identityMode String @default("link")

  // Workflow runtime — set when driven by a saved signing workflow with approval /
  // branch logic. The graph is frozen at send; currentNodeId is the interpreter position.
  workflowGraphJson Json?
  currentNodeId     String?

  // Source of the document (any/all may be null; the PDF to sign is unsignedPdfRef)
  documentId String?
  quoteId    String?
  jobCardId  String?
  contactId  String?
  templateId String? // DocBuilderTemplate it was generated from, if any

  snapshotJson   Json? // frozen resolved document at send time (what the signer sees)
  /// The BRAND as it was at send time — the {{company.*}} tokens and the logo.
  ///
  /// Frozen for the same reason snapshotJson is. That column freezes the
  /// document; this one freezes who it says it is FROM. Without it, a re-render
  /// of a signed request resolved the brand LIVE, so a tenant rebranding — or a
  /// platform admin changing their logo — retroactively restated whose contract
  /// a customer had already signed. The sealed PDF at signedPdfRef never
  /// changed, but the print and preview views disagreed with it.
  ///
  /// Null on every row that predates this and on any request created before a
  /// brand existed; renderers fall back to resolving live, which is exactly
  /// what they did before. So this is additive in behaviour as well as in schema.
  brandJson      Json?
  unsignedPdfRef String? // storage ref of the PDF sent for signing
  signedPdfRef   String? // storage ref of the sealed, completed PDF
  signedPdfHash  String? // sha-256 of the completed PDF

  /// Independent proof of WHEN, from an RFC 3161 timestamp authority.
  ///
  /// The evidence chain shows nobody altered a record without full database
  /// access; it cannot show a third party when anything happened, because we
  /// produce and store all of it. A timestamp authority attests that
  /// `signedPdfHash` existed at `timestampedAt` — and only a hash ever leaves
  /// the system, so the authority learns nothing about the document.
  ///
  /// Nullable by design: a timestamp is evidence ABOUT a signature, not part of
  /// one. An unreachable authority must never cost a signed contract, so NULL
  /// means "not timestamped" and is stated as such on the certificate.
  timestampToken     String?
  timestampedAt      DateTime?
  timestampAuthority String?
  signedDocId    String? // Document row of the filed, completed PDF
  message     String? // note shown to recipients
  createdById String?
  sentAt      DateTime?
  completedAt DateTime?
  declinedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  /// LEASE held by the one worker re-driving this request's lost fan-out.
  ///
  /// recoverStrandedCompletions sends email and fires automations, so exactly one
  /// worker may be doing that at a time. A lock taken and released around a
  /// bookkeeping transaction cannot express that — the transaction commits and the
  /// sending starts afterwards, unprotected — so the claim is a LEASE instead:
  /// one conditional UPDATE sets `recoveryLeaseUntil` into the future, and a
  /// second worker's identical UPDATE matches no row until it expires.
  ///
  /// It expires because the alternative is worse: a worker killed mid-send (a
  /// serverless timeout is routine here) would otherwise hold the request
  /// unrecoverable forever, which is the exact failure this whole sweep exists to
  /// end. `recoveryLeaseOwner` names the holder, so a release only clears a lease
  /// we still own and a stuck holder is identifiable in the log.
  recoveryLeaseUntil DateTime?
  recoveryLeaseOwner String?

  /// Set when the sweep has spent its attempts and stopped. Two jobs:
  /// it is the durable "this needs a person" flag, and it takes the request OUT
  /// of the candidate query — without it, capped requests keep filling the
  /// oldest-first batch and newer, still-recoverable failures are never selected.
  recoveryExhaustedAt DateTime?

  recipients SignatureRecipient[]
  fields     SignatureField[]
  events     SignatureEvent[]
  approvals  ApprovalStep[]

  @@index([status, updatedAt])
  @@index([quoteId])
  @@index([jobCardId])
  @@index([contactId])
  @@index([tenantId])
  @@unique([tenantId, id])
}

/// An internal approval gate materialised from a workflow's approval node. A CRM
/// person approves/rejects (decision mode) — signature-mode approvals are handled
/// as approver SignatureRecipients instead. Reject routes down the node's rejected branch.
model ApprovalStep {
  id        String           @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  requestId String
  request   SignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  nodeId String // workflow node this step was materialised from
  label  String
  mode   String @default("decision") // decision | signature

  assigneeType   String // staff | role | owner
  assigneeUserId String?
  assigneeRole   String?
  assigneeName   String?
  assigneeEmail  String?

  /// SHA-256 DIGEST of the approve/reject capability — never the raw value.
  /// The raw token exists only in the emailed URL; look a link up by hashing what
  /// arrived (hashSignToken) and querying this column. A database trigger refuses
  /// any write here that is not a 64-character digest.
  token String @unique

  /// AES-256-GCM of the raw capability, so a resend can repeat the SAME link
  /// instead of quietly invalidating the one already in the approver's inbox.
  /// NULL is normal (historic rows, and any row minted before the key existed) —
  /// a resend then rotates to a fresh capability rather than failing.
  tokenCiphertext String?
  /// Set the moment the step is decided: a spent approval link stops working
  /// immediately rather than remaining valid until someone notices.
  tokenRevokedAt  DateTime?

  status         String    @default("pending") // pending | approved | rejected
  decidedByUserId String?
  decidedByName  String?
  decidedAt      DateTime?
  reason         String?

  order     Int      @default(0)
  createdAt DateTime @default(now())

  // At most one step per workflow node per request — makes decision-approval
  // materialisation idempotent so concurrent advances can't create two steps
  // (two valid tokens / duplicate notifications) for the same node.
  @@unique([requestId, nodeId])
  @@index([requestId])
  @@index([status])
  @@index([tenantId])
}

model SignatureRecipient {
  id        String           @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  requestId String
  request   SignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  name  String
  email String?
  phone String? // for WhatsApp / SMS
  role  String  @default("signer") // signer|approver|viewer
  order Int     @default(0) // signing order for sequential
  color String  @default("#2563eb")
  nodeId String? // workflow signer node this recipient was materialised from

  /// SHA-256 DIGEST of this recipient's signing capability — never the raw value.
  ///
  /// A signing link is a bearer credential: whoever holds it can open and sign
  /// this contract. Storing it readable meant a backup file, a database dump or
  /// any read that bypassed row-level security handed over a working ability to
  /// sign as the customer. The raw token now exists only in the delivered URL;
  /// resolve a link by hashing what arrived (hashSignToken) and querying here.
  /// A database trigger refuses any write that is not a 64-character digest.
  token  String @unique

  /// AES-256-GCM of the raw capability, so a reminder can repeat the SAME link
  /// rather than silently invalidating the one already in the signer's inbox.
  /// NULL is normal (historic rows, and any row minted before the key existed) —
  /// a reminder then rotates to a fresh capability rather than failing.
  tokenCiphertext String?
  /// Set when the envelope reaches a terminal state, so a completed or declined
  /// document's links stop working at once instead of remaining live.
  tokenRevokedAt  DateTime?

  /// Step-up identity, when the document asks for more than link possession.
  /// `identityVerifiedAt` is what the signing route actually gates on;
  /// `identityMethod` records which channel proved it (email_otp | sms_otp) so
  /// the certificate can state what was proven rather than implying more;
  /// `identityEvidenceHash` binds that proof to the challenge, IP and user agent
  /// without keeping a second readable copy of the signer's details.
  identityVerifiedAt   DateTime?
  identityMethod       String?
  identityEvidenceHash String?

  status String @default("pending") // pending|sent|viewed|signed|declined

  signedAt        DateTime?
  signedName      String?
  signatureRef    String? // PNG of their drawn/typed signature
  viewedAt        DateTime?
  declinedAt      DateTime?
  declineReason   String?
  signerIp        String?
  signerUserAgent String?
  remindedAt      DateTime?
  // Claim-lease timestamp: set when notifyRecipient claims pending→sending,
  // read only to detect a claim that never reached its finalize update (crash
  // or timeout mid-send) — see recoverStaleSigningClaims in signing/dispatch.ts.
  sendingAt       DateTime?

  /// When THIS recipient was successfully sent the final sealed PDF.
  ///
  /// The completion fan-out is a loop over recipients and it can fail part way —
  /// one bad address, one SMTP rejection. Without a per-recipient marker the only
  /// options are "declare the whole fan-out done" (the recipients who were never
  /// reached never are) or "retry the whole fan-out" (everyone who already has
  /// their contract gets it again). This records delivery one address at a time,
  /// so a retry sends only to whoever is still missing it.
  completedEmailSentAt DateTime?

  fields    SignatureField[]
  responses SignatureFieldResponse[]

  @@index([requestId, order])
  @@index([tenantId])
  @@unique([tenantId, id])
}

model SignatureField {
  id        String           @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  requestId String
  request   SignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  recipientId String?
  recipient   SignatureRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  kind     String // signature|initials|date|text|checkbox|radio|dropdown|attachment|stamp
  page     Int
  x        Float
  y        Float
  width    Float
  height   Float
  required Boolean @default(true)
  label    String  @default("")

  value    String? // captured text / signature ref / "true" — FIRST committed value (what the sealed PDF stamps)
  filledAt DateTime?

  responses SignatureFieldResponse[]

  @@index([requestId])
  @@index([tenantId])
  @@unique([tenantId, id])
}

/// One recipient's answer to a single signature field. `SignatureField.value`
/// holds only the FIRST committed value — the field has a single placed position,
/// so the sealed PDF can stamp exactly one value there. On a SHARED field
/// (recipientId null, fillable by any recipient) every later signer's answer would
/// otherwise be lost (overwritten, or dropped by the first-write-wins guard). This
/// table records each recipient's response individually and durably — one row per
/// (field, recipient) — so no signer's acknowledgement is ever silently discarded.
model SignatureFieldResponse {
  id        String @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.

  fieldId String
  field   SignatureField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  recipientId String
  recipient   SignatureRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  value    String
  filledAt DateTime @default(now())

  // At most one response per recipient per field: a re-submission updates that
  // recipient's own row, never forges a second acknowledgement.
  @@unique([fieldId, recipientId])
  @@index([recipientId])
  @@index([tenantId])
}

// Append-only audit trail — never updated or deleted.
model SignatureEvent {
  id        String           @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  requestId String
  request   SignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  recipientId String?
  /// created|sent|delivered|opened|viewed|field_filled|signed|declined|completed|reminded|downloaded|voided|recovery_attempt
  ///
  /// `completed` is written LAST by completeSignatureRequest — after the
  /// notification and post-completion fan-out, not before it. Its ABSENCE on a
  /// request whose status is already `completed` therefore means one specific
  /// thing: the transaction committed and the external work never finished. That
  /// is the detector recoverStrandedCompletions() sweeps on, so this event is
  /// load-bearing and not merely a trail entry.
  ///
  /// `recovery_attempt` records one pass of that sweep, written BEFORE the work
  /// so attempts stay bounded when a request cannot be repaired.
  type        String
  actor       String // "Denago: <name>" | recipient name | "system"
  channel     String? // email|whatsapp|sms|in_person|web
  ip          String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  /// Tamper-evident chain. Database triggers own all four columns — the table is
  /// append-only (UPDATE and DELETE are refused) and each row is linked to the
  /// one before it, so removing or editing any event breaks every hash after it.
  ///
  /// `payloadHash` is computed by the APPLICATION (see signEventPayloadHash) and
  /// is the only one an insert supplies; the trigger refuses a row without it.
  /// The other three carry defaults purely so an ordinary typed create need not
  /// name them — the trigger overwrites all three, so the defaults are never the
  /// values actually stored.
  ///
  /// The digest is taken over a canonical string the application builds, NOT over
  /// a jsonb serialised inside PostgreSQL: the latter ties the chain to the
  /// server's JSON key ordering and session TimeZone, so a bundle restored onto a
  /// differently configured server would fail to verify through no fault of the
  /// evidence.
  sequence    Int      @default(0)
  prevHash    String   @default("")
  payloadHash String
  eventHash   String   @default("")

  @@index([requestId, createdAt])
  @@index([tenantId])
  @@unique([requestId, sequence])
}

// ── Document Studio: free-form BlockNote documents ──────────────────
