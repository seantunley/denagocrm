// A fleet / B2B account — an estate, golf course, resort or business that
// owns many carts. Groups vehicles for a fleet-level service overview.
// A managed account: an estate, golf course, lodge, resort or business that runs
// a group of vehicles. A fleet is a BUSINESS RECORD in its own right — the
// registration, VAT and billing details below are the ones a quote or invoice
// addressed to the fleet would carry, which is why they live here and not on the
// manager's personal contact record.
//
// Quotes ARE issued to a fleet: `Quote.fleetId` names the account a quote is
// billed to, and lib/quoteBillTo.ts is the one place that turns a quote plus its
// fleet into the block every renderer prints. The fields below are what that
// block shows when the account is a fleet rather than a person.
model Fleet {
  id          String    @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  name        String
  type        String? // see lib/fleetTypes.ts — estate | golf-course | lodge | resort | business | other
  notes       String?
  // The ONE primary contact / fleet manager. The MANY side — every contact that
  // belongs to this fleet — is `Contact.fleetId`. Different facts, kept apart on
  // purpose: this is who you phone, that is who is covered.
  contactId   String?

  // Business record. All nullable and additive: a fleet created before these
  // existed is still valid, just missing its billing detail.
  registrationNumber String? // company / CK registration number
  vatNumber          String? // VAT registration number (same field name as Contact.vatNumber)
  billingEmail       String? // where invoices go — distinct from the manager's personal email
  billingPhone       String?
  // Address fields reuse Contact's exact names and meanings rather than
  // inventing a parallel addressLine1/addressLine2 vocabulary for the same idea.
  address            String? // street address / estate + unit
  suburb             String?
  city               String?
  province           String?
  postalCode         String?

  createdAt   DateTime  @default(now())
  createdById String?
  deletedAt   DateTime?

  vehicles Vehicle[]
  @@index([tenantId])
  @@unique([tenantId, id])
}

// A warranty claim against a cart. Lightweight workflow: open → approved/
// rejected → resolved, with a free-text resolution note.
model WarrantyClaim {
  id          String    @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  status      String    @default("open") // open | approved | rejected | resolved
  description String
  resolution  String?
  claimedAt   DateTime  @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  vehicleId   String
  vehicle     Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  contactId   String?
  jobCardId   String?
  createdById String?

  @@index([status, claimedAt])
  @@index([vehicleId])
  @@index([tenantId])
}

// A recall or service bulletin for a cart model. Owners of matching carts can
// be notified in one click.
model Recall {
  id          String    @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  title       String
  model       String // affected cart model (matches Vehicle.model)
  description String
  active      Boolean   @default(true)
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  createdById String?

  @@index([active])
  @@index([tenantId])
}

// EV battery health snapshots — track state-of-health, voltage and charge
// cycles over time so degradation is visible and replacement conversations
// happen proactively (the battery is a cart's most expensive component).
model BatteryCheck {
  id            String   @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  checkedAt     DateTime @default(now())
  packSerial    String?
  stateOfHealth Int? // % of original capacity
  voltage       Float? // resting pack voltage
  cycles        Int? // charge cycles
  notes         String?
  createdAt     DateTime @default(now())

  vehicleId    String
  vehicle      Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  jobCardId    String?
  recordedById String? // user who logged it (loose pointer)

  @@index([vehicleId, checkedAt])
  @@index([tenantId])
}

model MileageLog {
  id         String   @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  km         Int
  recordedAt DateTime @default(now())
  note       String?

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  @@index([tenantId])
