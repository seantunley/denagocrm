generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// [Full schema with JobCard updated - omitted for brevity in this response, but includes new fields and JobCardTimeEntry model]
model JobCard {
  id          String    @id @default(cuid())
  number      Int       @unique
  status      String    @default("booking") // booking | checkin | diagnosis | approval | repair | qc | ready | collected | completed
  description String
  kmIn        Int?
  openedAt    DateTime  @default(now())
  completedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  estimatedHours  Float?
  actualHours     Float?    @default(0)
  labourRateCents Int?      @default(0)
  bay             String?
  priority        String    @default("normal")

  deletedAt     DateTime?
  deletedByName String?
  deleteReason  String?

  signToken       String?   @unique
  signedAt        DateTime?
  signedByName    String?
  signatureRef    String?
  signerIp        String?
  signerUserAgent String?
  signedPdfHash   String?
  viewedAt        DateTime?

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  technicianId String?
  technician   User?   @relation("JobCardTechnician", fields: [technicianId], references: [id])

  timeEntries JobCardTimeEntry[]
  items         JobCardItem[]
  serviceRecord ServiceRecord?
  documents     Document[]

  additionalApprovalRequired Boolean @default(false)
  additionalApprovedAt       DateTime?
  additionalApprovedById     String?
  additionalApprovedBy       User? @relation(fields: [additionalApprovedById], references: [id])

  isSubcontracted Boolean @default(false)
  subcontractor   String?
  subCostCents    Int @default(0)

  checklist Json?
}

model JobCardTimeEntry {
  id          String   @id @default(cuid())
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  hours       Float?
  notes       String?
  createdAt   DateTime @default(now())

  jobCardId   String
  jobCard     JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  technicianId String
  technician  User @relation(fields: [technicianId], references: [id])
}

