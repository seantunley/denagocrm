// AutomationRule and AutomationLog were dropped in migration
// 20260802120000_retire_automation_rules. They were the storage for one of THREE
// engines that all did "when X happens to a lead, send an email / create an
// activity / move a stage". The Journey engine (prisma/journeys.prisma) is the
// one that survives; that migration converted every rule into a
// Journey/JourneyVersion, and JourneyRun/JourneyStepLog replaces AutomationLog
// as the run history FROM THAT POINT ON — which is why the history BEFORE it is
// kept below rather than dropped with the table.

/// The AutomationLog history, archived rather than destroyed.
///
/// AutomationLog was the ONLY execution record the retired AutomationRule engine
/// ever produced — one row per firing, with the lead and the outcome — and there
/// was no second copy of it anywhere. Dropping the table would have destroyed
/// the whole audit trail of what fired and when, which is exactly the question
/// asked after a customer says "why did I get this email".
///
/// Written once, by 20260802120000_retire_automation_rules, and never again: no
/// application code writes here. It is DENORMALISED because the rule table went
/// away in the same migration, so a bare copy of `ruleId` would be an orphan —
/// the rule's name/trigger/action ride along, plus `journeyId`, the deterministic
/// id of the Journey that rule became, so the history joins forward:
///
///   basePrisma.retiredAutomationLog.findMany({ orderBy: { createdAt: "desc" } })
///   SELECT l.*, j."name" FROM "RetiredAutomationLog" l
///     LEFT JOIN "Journey" j ON j."id" = l."journeyId";
///
/// Read it on the system path (basePrisma / psql): tenantId was nullable and
/// inert on AutomationLog, so most archived rows carry NULL and the tenant-scoped
/// client — which applies the same strict RLS policy AutomationLog had — will not
/// show them.
model RetiredAutomationLog {
  /// The original AutomationLog id, so re-running the migration is a no-op.
  id          String   @id
  tenantId    String?
  ruleId      String
  /// Copied off AutomationRule before it was dropped; NULL if the rule row had
  /// already been deleted when the log was archived.
  ruleName    String?
  ruleTrigger String?
  ruleAction  String?
  /// 'jrn_rule_' || md5(ruleId) — the Journey the rule was converted into.
  journeyId   String?
  leadId      String
  note        String?
  /// When the automation fired (the original AutomationLog.createdAt).
  createdAt   DateTime
  /// When this migration copied the row across.
  archivedAt  DateTime @default(now())

  @@index([ruleId, leadId])
  @@index([tenantId])
  @@index([journeyId])
}

model Quote {
  id         String    @id @default(cuid())
  number     Int       @unique
  status     String    @default("draft") // draft | sent | accepted | declined
  validUntil DateTime?
  terms      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Multi-tenancy (Phase B — additive/inert): owning tenant. See Contact.tenantId.
  // NOTE: `number` stays globally @unique here; the risky swap to
  // @@unique([tenantId, number]) is a separate backup-first PR.
  tenantId   String?

  // CPQ (phase 1): tax mode + deposit terms
  taxInclusive Boolean @default(true) // unit prices already include VAT
  depositType  String? // percent | amount
  depositValue Float? // % when percent, rands when amount

  deletedAt     DateTime?
  deletedByName String?
  deleteReason  String?

  signToken            String?   @unique
  signedAt             DateTime?
  signedByName         String?
  signatureRef         String?
  signerIp             String?
  signerUserAgent      String?
  signedPdfHash        String? // SHA-256 of the filed signed PDF (tamper evidence)
  signLinkCreatedAt    DateTime?
  viewedAt             DateTime? // first time the customer opened the signing link
  declinedAt           DateTime?
  declineReason        String?
  reminderSentAt       DateTime? // unsigned-quote nudge already sent
  // Fulfilment flow after signing (all set manually from the Deliveries board)
  invoicedAt           DateTime?
  depositPaidAt        DateTime?
  deliveryScheduledFor DateTime?
  deliveredAt          DateTime?
  deliveredByName      String? // driver / who handed the cart over
  deliveryChecklist    Json? // handover checklist { item: boolean }
  deliverySignatureRef String? // stored PNG of the customer's on-handover signature
  dealerSignedAt       DateTime?
  dealerSignedByName   String?
  dealerSignatureRef   String?

  // Version control: a revision points at the quote it replaces; the old one
  // is stamped superseded and becomes read-only.
  changeRequestedAt DateTime?
  changeRequestNote String?
  revisionOfId      String?
  revisionOf        Quote?    @relation("QuoteRevisions", fields: [revisionOfId], references: [id], onDelete: SetNull)
  revisions         Quote[]   @relation("QuoteRevisions")
  supersededAt      DateTime?

  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  // THE ACCOUNT THIS QUOTE IS BILLED TO — a fleet / B2B account.
  //
  // Set ALONGSIDE contactId, never instead of it. `contactId` stays the PERSON:
  // the fleet manager you deal with, who signs, and who the quote is sent to.
  // `fleetId` is the BUSINESS the invoice is addressed to, and whose registration
  // number, VAT number and billing address print on it. A lodge ordering six
  // carts needs both facts and they are not the same fact — collapsing them into
  // one column would lose whichever one the fleet case needs most.
  //
  // Scalar with no Prisma relation, matching Contact.fleetId and Fleet.contactId
  // (see their comments): resolution is app-layer and TENANT-SCOPED, so an id
  // from another workspace simply fails to resolve rather than being caught by a
  // foreign key after the row is already written. lib/quoteBillTo.ts is the only
  // place that resolves it.
  fleetId     String?

  createdById String?
  createdBy   User?    @relation("QuoteCreator", fields: [createdById], references: [id])

  items     QuoteItem[]
  fees      QuoteFee[]
  soldStock StockUnit[] @relation("StockSold")
  stockReservations StockReservation[]

  @@index([tenantId])
  // The fleet page lists an account's quotes by this column.
  @@index([fleetId])
  @@unique([tenantId, id])
}

model QuoteItem {
  id             String @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  description    String
  qty            Float  @default(1)
  unitPriceCents Int    @default(0)
  discountPct    Float  @default(0)
  colorPreference String?

  // CPQ (phase 1)
  kind        String  @default("product") // product | accessory | optional | trade_in | service_plan | warranty
  taxRatePct  Float   @default(15) // per-line VAT
  costCents   Int     @default(0) // unit cost, for margin visibility
  optional    Boolean @default(false) // customer-selectable add-on
  selected    Boolean @default(true) // whether an optional line is currently chosen
  sortOrder   Int     @default(0)

