model AuditLog {
  id        String   @id @default(cuid())
  action    String // e.g. contact.created, lead.stage_changed, jobcard.completed
  summary   String // human-readable: what was done
  contactId String? // the customer this relates to
  leadId    String?
  userId    String?
  userName  String // denormalized so history survives user changes
  // Acting tenant captured from the session (multi-tenancy). Nullable/best-effort
  // — null for system/cron/portal writes and sessions minted before tid existed.
  tenantId  String?
  createdAt DateTime @default(now())

  @@index([contactId, createdAt])
  @@index([leadId, createdAt])
  @@index([tenantId, createdAt])
