generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  passwordHash      String
  role              String    @default("member") // owner | member
  // RETIRED — no code reads this. It was a second authorization system alongside
  // RBAC (UserRole/RolePermission): the edge proxy gated routes on this CSV while
  // /settings/access never wrote to it, so a granted permission still bounced the
  // user to "/". Route access is now derived from RBAC — see src/lib/routeAccess.ts.
  // Column and default left as they are so this needs no migration; drop both once
  // no deployed build reads the field.
  modules           String    @default("crm,workshop,reports,inbox") // RETIRED, inert
  totpSecret        String? // encrypted TOTP secret — the LIVE factor
  /// Encrypted secret for an authenticator being enrolled, not yet trusted.
  ///
  /// Enrolment used to overwrite `totpSecret` and clear `totpEnabledAt` on the
  /// first click, which is a working 2FA disable available to anyone holding a
  /// session — and a Server Action is a POST endpoint, reachable without the
  /// screen that renders the button. `disableTotp` demands a current code for
  /// exactly this reason; starting an "enrolment" walked around it.
  ///
  /// A replacement lands here instead and is promoted to `totpSecret` only once
  /// a code proves the new authenticator holds it. Nothing authenticates against
  /// this column.
  totpPendingSecret String?
  totpEnabledAt     DateTime?
  totpBackupCodes   String? // JSON array of bcrypt-hashed one-time backup codes
  sessions          UserSession[]
  passkeys          Passkey[]
  emailOtpEnabled   Boolean   @default(false)
  loginOtpHash      String? // hashed email login code
  loginOtpExpires   DateTime?
  passwordChangedAt DateTime?
  mobile            String?
  jobTitle          String?
  avatarRef         String?
  avatarMimeType    String?
  avatarUpdatedAt   DateTime?
  signatureHtml     String? // custom override; blank = branded template
  drawnSignatureRef String? // saved handwritten signature for countersigning documents
  createdAt         DateTime  @default(now())

  communications     Communication[]
  documents          Document[]
  serviceRecords     ServiceRecord[]
  leadsAssigned      Lead[]
  leadsCreated       Lead[]           @relation("LeadCreator")
  contactsOwned      Contact[]        @relation("ContactOwner")
  contactsCreated    Contact[]        @relation("ContactCreator")
  activitiesAssigned Activity[]       @relation("ActivityAssignee")
  activitiesCreated  Activity[]       @relation("ActivityCreator")
  libraryVersions    LibraryVersion[]
  quotesCreated      Quote[]          @relation("QuoteCreator")
  jobCardsAsTech     JobCard[]        @relation("JobCardTechnician")
  jobCardTimeEntries JobCardTimeEntry[] @relation("JobCardTimeTechnician")
  campaignsCreated   Campaign[]       @relation("CampaignCreator")
  stockReservations  StockReservation[]
  goodsReceipts      GoodsReceipt[]
  timelinePins       TimelinePin[]
  memberships        TenantMember[]
  ownedTenants       Tenant[]       @relation("TenantOwner")
  conversationsAssigned Conversation[]      @relation("ConversationAssignee")
  conversationNotes     ConversationNote[]  @relation("ConversationNoteAuthor")
  conversationDrafts    ConversationDraft[] @relation("ConversationDraftOwner")

  // Multi-tenancy: owning tenant. Backfilled from TenantMember (one-user-one-tenant).
  // Auth paths use basePrisma (bypass_rls='on') so login still works without a scope.
  tenantId String?

  @@index([tenantId])
}

// User-pinned timeline entries (communications / activities) that float to the
// top of a contact's Live timeline until unpinned. Polymorphic itemId (no FK) so
// it can reference either a Communication or an Activity; app code clears the pin
// when the underlying item is deleted. Read/written via raw SQL in lib/timelinePins.
model TimelinePin {
  id         String   @id
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  kind       String // communication | activity
  itemId     String
  pinnedAt   DateTime @default(now())
  pinnedById String
  pinnedBy   User     @relation(fields: [pinnedById], references: [id], onDelete: Cascade)

  @@unique([kind, itemId])
  @@index([pinnedAt])
  @@index([tenantId])
}

model AppSetting {
  id       String @id @default(dbgenerated("gen_random_uuid()::text"))
  key      String
  value    String
  // Non-null: the founding tenant (DEFAULT_TENANT_ID) owns platform-default
  // settings. A null tenantId would become invisible under FORCE RLS once
  // enforcement is on (the policy requires a matching tenant), so every row is
  // owned by exactly one tenant. Backfilled + set NOT NULL in migration
  // 20260727210000_appsetting_tenant_not_null.
  tenantId String

  @@unique([tenantId, key])
  @@index([tenantId])
}

// Company document library (brochures, price lists) with version control
model LibraryDocument {
  id        String   @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  name      String
  category  String? // Brochure | Price list | Spec sheet | Other
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt     DateTime?
  deletedByName String?
  deleteReason  String?

  versions LibraryVersion[]
  @@index([tenantId])
  @@unique([tenantId, id])
}

model LibraryVersion {
  id         String   @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  version    Int
  fileName   String
  storedName String
  mimeType   String
  sizeBytes  Int
  note       String? // what changed in this version
  createdAt  DateTime @default(now())

  documentId   String
  document     LibraryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User            @relation(fields: [uploadedById], references: [id])

  @@unique([documentId, version])
  @@index([tenantId])
}

model Product {
  id             String   @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  name           String
  sku            String?
  category       String?
  basePriceCents Int      @default(0)
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  deletedAt     DateTime?
  deletedByName String?
  deleteReason  String?

  colors             ProductColor[]
  leads              Lead[]
  vehicles           Vehicle[]
  stockUnits         StockUnit[]
  quoteItems         QuoteItem[]
  purchaseOrderLines PurchaseOrderLine[]
  @@index([tenantId])
  @@unique([tenantId, id])
}

model PurchaseOrder {
  id         String      @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  reference  String? // supplier's PO / order number
  supplier   String      @default("Denago")
  status     String      @default("ordered") // ordered | received | cancelled
  orderedAt  DateTime    @default(now())
  expectedAt DateTime?
  notes      String?
  createdAt  DateTime    @default(now())
  deletedAt  DateTime?
  units      StockUnit[]

  lines         PurchaseOrderLine[]
  goodsReceipts GoodsReceipt[]
  stockEvents   StockEvent[]
  @@index([tenantId])
  @@unique([tenantId, id])
}

model StockUnit {
  id        String    @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  productId String
  product   Product   @relation(fields: [productId], references: [id])
  color     String?
  serial    String? // VIN / serial number
  status    String    @default("incoming") // incoming | available | reserved | sold
  costCents Int       @default(0)
  notes     String?
  createdAt DateTime  @default(now())
  arrivedAt DateTime?
  soldAt    DateTime?
  deletedAt DateTime?

  purchaseOrderId   String?
  purchaseOrder     PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  reservedForLeadId String?
  reservedForLead   Lead?          @relation("StockReserved", fields: [reservedForLeadId], references: [id], onDelete: SetNull)
  soldQuoteId       String?
  soldQuote         Quote?         @relation("StockSold", fields: [soldQuoteId], references: [id], onDelete: SetNull)
  purchaseOrderLineId String?
  purchaseOrderLine   PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: SetNull)

  // Stock operations platform (phases 1-4). Partial/expression unique indexes
  // (active serial on UPPER(serial), partial stockNumber) live in the migration
  // only — Prisma can't model them; this mirrors migrations 50 & 52.
  stockNumber     String?   @unique
  location        String?
  // Optional organisational label (demo / showroom / consignment / hold …),
  // configurable in settings and DISTINCT from the lifecycle `status`.
  label           String?
  condition       String    @default("new")
  batterySerial   String?
  chargerSerial   String?
  odometerKm      Int?
  landedCostCents Int       @default(0)
  salePriceCents  Int?
  pdiStatus       String    @default("not_started")
  pdiCompletedAt  DateTime?
  deliveredAt     DateTime?
  warrantyStartAt DateTime?
  warrantyEndAt   DateTime?
  updatedAt       DateTime  @default(now()) @updatedAt

  reservations      StockReservation[]
  events            StockEvent[]
  goodsReceiptLines GoodsReceiptLine[]

  @@index([status])
  @@index([productId])
  @@index([location, status], map: "StockUnit_location_status_idx")
  @@index([arrivedAt], map: "StockUnit_arrivedAt_idx")
  @@index([purchaseOrderLineId], map: "StockUnit_po_line_idx")
  @@index([tenantId])
  @@unique([tenantId, id])
}

model StockReservation {
  id                   String    @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  stockUnitId          String
  stockUnit            StockUnit @relation(fields: [stockUnitId], references: [id], onDelete: Cascade)
  leadId               String
  lead                 Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  quoteId              String?
  quote                Quote?    @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  status               String    @default("active")
  reservedAt           DateTime  @default(now())
  expiresAt            DateTime?
  depositRequiredCents Int       @default(0)
  depositReceivedAt    DateTime?
  releasedAt           DateTime?
  releaseReason        String?
  reservedById         String
  reservedBy           User      @relation(fields: [reservedById], references: [id], onDelete: Restrict)

  // One active reservation per unit is enforced by a partial unique index
  // (StockReservation_active_unit_key WHERE status='active') in the migration.
  @@index([status, expiresAt], map: "StockReservation_expiry_idx")
  @@index([leadId, status], map: "StockReservation_lead_idx")
  @@index([tenantId])
}

model StockEvent {
  id              String         @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  stockUnitId     String?
  stockUnit       StockUnit?     @relation(fields: [stockUnitId], references: [id], onDelete: SetNull)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  eventType       String
  fromStatus      String?
  toStatus        String?
  leadId          String?
  quoteId         String?
  reason          String?
  detail          String?
  costBeforeCents Int?
  costAfterCents  Int?
  performedById   String
  performedByName String
  occurredAt      DateTime       @default(now())

  @@index([stockUnitId, occurredAt(sort: Desc)], map: "StockEvent_unit_time_idx")
  @@index([purchaseOrderId, occurredAt(sort: Desc)], map: "StockEvent_po_time_idx")
  @@index([tenantId])
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  color           String?
  orderedQty      Int
  receivedQty     Int           @default(0)
  unitCostCents   Int           @default(0)
  freightCents    Int           @default(0)
  notes           String?
  createdAt       DateTime      @default(now())

  goodsReceiptLines GoodsReceiptLine[]
  units             StockUnit[]

  @@index([purchaseOrderId], map: "PurchaseOrderLine_po_idx")
  @@index([tenantId])
  @@unique([tenantId, id])
}

model GoodsReceipt {
  id              String        @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  reference       String?
  receivedAt      DateTime      @default(now())
  receivedById    String
  receivedBy      User          @relation(fields: [receivedById], references: [id], onDelete: Restrict)
  notes           String?

  lines GoodsReceiptLine[]

  @@index([purchaseOrderId, receivedAt(sort: Desc)], map: "GoodsReceipt_po_idx")
  @@index([tenantId])
  @@unique([tenantId, id])
}

model GoodsReceiptLine {
  id                  String             @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLineId String?
  purchaseOrderLine   PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: SetNull)
  stockUnitId         String
  stockUnit           StockUnit          @relation(fields: [stockUnitId], references: [id], onDelete: Restrict)
  accepted            Boolean            @default(true)
  conditionNote       String?

  @@index([goodsReceiptId], map: "GoodsReceiptLine_receipt_idx")
  @@index([tenantId])
}

model ProductColor {
  id        String  @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  name      String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([tenantId])
}

model Contact {
  id            String   @id @default(cuid())
  // isCompany is DELIBERATELY still a boolean, not an enum. The customer-type
  // selector offers three options (individual / business / fleet) and maps them
  // onto this flag plus `fleetId` below — see lib/contactKind.ts for the mapping
  // and why. Every existing reader of isCompany keeps its meaning: a fleet
  // contact is a company contact that also belongs to a fleet.
  isCompany     Boolean  @default(false)
  firstName     String
  lastName      String?
  company       String?
  vatNumber     String? // VAT registration number — companies and fleet accounts only
  email         String?
  phone         String?
  whatsapp      String?
  referralCode  String?  @unique // customer's shareable referral code
  messengerPsid String?  @unique // Facebook Messenger page-scoped id
  instagramId   String?  @unique // Instagram-scoped user id
  address       String? // street address / estate + unit
  suburb        String?
  city          String?
  province      String?
  postalCode    String?
  source          String?
  notes           String?
  /// The lead whose notes were COPIED into `notes` when this contact was created
  /// from it. Provenance, not a relation: it answers "is the contact's note the
  /// same event as that lead's note?" so the timeline can show one entry instead
  /// of two. Comparing the TEXT answered that question wrongly whenever two
  /// genuinely separate notes happened to say the same thing.
  notesFromLeadId String?
  marketingOptOut Boolean @default(false) // excluded from bulk campaigns
  research        String? // latest AI research briefing (shown in the Research tab)
  researchedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deletedAt     DateTime?
  deletedByName String?
  deleteReason  String?

  // Multi-tenancy (Phase B — additive/inert): owning tenant. Nullable + backfilled
  // now; a later PR flips NOT NULL + adds the FK once the backfill is confirmed on
  // prod. Nothing reads it yet — behaviour is unchanged.
  tenantId String?

  // FLEET MEMBERSHIP — which fleet account this contact belongs to.
  //
  // This is NOT the same thing as `Fleet.contactId`, and the two must not be
  // collapsed: `Fleet.contactId` names the ONE primary contact / fleet manager
  // for a fleet, while this column is the MANY side — every person who belongs
  // to that fleet. A fleet's primary contact is normally also a member, but a
  // fleet has many members and only one manager.
  //
  // Scalar with no Prisma relation, matching `Fleet.contactId` (also scalar) and
  // the TenantApiKey/ChannelIdentity convention: resolution is app-layer and
  // tenant-scoped, so a cross-tenant id simply fails to resolve rather than
  // being caught by a foreign key after the fact.
  fleetId     String?

  ownerId     String?
  owner       User?   @relation("ContactOwner", fields: [ownerId], references: [id])
  createdById String?
  createdBy   User?   @relation("ContactCreator", fields: [createdById], references: [id])

  leads             Lead[]
  communications    Communication[]
  conversations     Conversation[]
  referralsMade     Referral[]      @relation("ReferralsMade")
  referredIn        Referral[]      @relation("ReferredIn")
  documents         Document[]
  vehicles          Vehicle[]
  jobCards          JobCard[]
  activities        Activity[]
  tags              Tag[]
  quotes            Quote[]
  researchNotes     ResearchNote[]
  campaignRecipients CampaignRecipient[]
  consentRecords    ConsentRecord[]

  @@index([tenantId])
  @@index([fleetId])
  @@unique([tenantId, id])
}

// POPIA consent ledger — an append-only history of consent given/withdrawn,
// so we can prove lawful basis for holding and marketing to a person.
model ConsentRecord {
  id          String   @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  type        String // marketing | service | data_processing
  granted     Boolean
  source      String? // form | phone | email | import | admin
  note        String?
  createdAt   DateTime @default(now())
  createdById String?

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
  @@index([tenantId])
}

model Tag {
  id       String    @id @default(cuid())
  tenantId String // Multi-tenancy: owning tenant (NOT NULL — 20260727220000).
  name     String
  color    String    @default("#64748b")
  contacts Contact[]
  @@unique([tenantId, name])
  @@index([tenantId])
}

model Campaign {
  id             String    @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  name           String
  channel        String // email | sms
  subject        String?
  body           String // plain-text (SMS body, or text fallback for email)
  htmlBody       String? // rich HTML for email campaigns
  audience       String // human-readable audience label
  recipientCount Int       @default(0)
  sentCount      Int       @default(0)
  failedCount    Int       @default(0)
  openCount      Int       @default(0) // unique recipients who opened
  clickCount     Int       @default(0) // unique recipients who clicked
  status         String    @default("draft") // draft | queued | sending | sent
  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  sentAt         DateTime?
  scheduledFor   DateTime?
  timezone       String?   @default("Africa/Johannesburg")
  createdById    String?
  createdBy      User?     @relation("CampaignCreator", fields: [createdById], references: [id])
  // Lifecycle / review workflow (migration-added; kept as plain scalars).
  ownerId              String?
  submittedById        String?
  submittedForReviewAt DateTime?
  reviewRequestedById  String?
  reviewNote           String?
  changesRequestedAt   DateTime?
  approvedById         String?
  approvedAt           DateTime?
  pausedAt             DateTime?
  cancelledAt          DateTime?
  completedAt          DateTime?
  archivedAt           DateTime?
  // Content / brief.
  preheader        String?
  objective        String?
  offer            String?
  productId        String?
  segmentId        String?
  audienceSnapshot Json?
  internalNotes    String?
  landingPageUrl   String?
  primaryCtaLabel  String?
  primaryCtaUrl    String?
  successMetric    String?
  budgetCents      Int?
  targetLeadCount  Int?
  targetRevenueCents Int?
  // Attribution / rollups.
  attributionWindowDays Int @default(30)
  conversionCount  Int @default(0)
  attributedRevenueCents Int @default(0)
  revenueCents     Int @default(0)
  suppressedCount  Int @default(0)
  unsubscribeCount Int @default(0)
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  recipients     CampaignRecipient[]

  @@index([status])
  @@index([tenantId])
  @@unique([tenantId, id])
}

model CampaignRecipient {
  id         String    @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  token      String    @unique // tracking/unsubscribe token
  status     String    @default("pending") // pending | queued | sending | sent | delivered | failed_temporary | failed_permanent | suppressed | cancelled
  sentAt     DateTime?
  openedAt   DateTime?
  openCount  Int       @default(0)
  clickedAt  DateTime?
  clickCount Int       @default(0)
  error      String?
  // Delivery / retry / attribution (migration-added).
  deliveredAt      DateTime?
  bouncedAt        DateTime?
  unsubscribedAt   DateTime?
  convertedAt      DateTime?
  conversionValueCents Int   @default(0)
  attemptCount     Int       @default(0)
  lastAttemptAt    DateTime?
  nextAttemptAt    DateTime?
  providerStatus   String?
  providerMessageId String?
  suppressionReason String?

  @@index([campaignId])
  @@index([status])
  @@index([tenantId])
}

model Segment {
  id        String   @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  name      String
  criteria  String // JSON: { source?, tagId?, hasVehicle?, serviceDue?, province?, wonOnly? }
  createdAt DateTime @default(now())
  @@index([tenantId])
  @@unique([tenantId, id])
}

/** A saved chatbot conversation flow (one can be marked active/live). */
model BotFlow {
  id         String   @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  name       String
  channel    String   @default("whatsapp")
  active     Boolean  @default(false)
  definition String // JSON { start, nodes, positions }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt @default(now())
  @@index([tenantId])
}

/** Live state of a customer's position in a chatbot flow. */
model BotSession {
  id        String   @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  channel   String   @default("whatsapp")
  key       String // phone digits (or web visitor id)
  nodeId    String? // current waiting node
  vars      String   @default("{}") // captured variables, JSON
  status    String   @default("active") // active | paused
  updatedAt DateTime @updatedAt @default(now())
  expiresAt DateTime

  @@unique([channel, key])
  @@index([tenantId])
}

model PipelineStage {
  id          String  @id @default(cuid())
  name        String
  order       Int
  color       String  @default("#64748b")
  entryAction String? // null | book_test_drive — required workflow on stage entry

  // Multi-tenancy (Phase B — additive/inert): owning tenant. See Contact.tenantId.
  tenantId String?

  leads Lead[]

  @@index([tenantId])
  @@unique([tenantId, id])
}

model Lead {
  id         String  @id @default(cuid())
  title      String
  name       String
  email      String?
  phone      String?
  source     String  @default("manual") // manual | facebook | instagram | website
  color      String? // colour of interest for the product
  notes      String?
  quantity   Int     @default(1) // number of carts wanted (drives the value)
  valueCents Int     @default(0)
  status     String  @default("open") // open | won | lost
  /// WHEN the deal closed — immutable lifecycle dates, not `updatedAt`.
  ///
  /// Both columns have existed since 52_pipelines_forecasting_rbac_audit, which
  /// also installs the Lead_sync_pipeline_forecast trigger that sets whichever
  /// one applies the first time a deal reaches that status, preserves it
  /// (COALESCE) on every later write, and clears BOTH when a deal is re-opened.
  /// They were never surfaced to Prisma, so every reporting surface dated a won
  /// deal by `updatedAt` instead — which moves whenever anyone adds a note, so
  /// editing an old deal silently restated the month it was won in.
  ///
  /// Read-only from the app's point of view: the trigger is the writer. See the
  /// long note above METRICS in src/lib/statistics.ts for why a bucketed report
  /// cannot use a mutable date at all.
  wonAt      DateTime?
  lostAt     DateTime?
  lostReason String?
  position   Int     @default(0)
  externalId String? @unique // e.g. Facebook leadgen_id
  raw        String? // raw intake payload (JSON string)

  // Multi-tenancy (Phase B — additive/inert): owning tenant. See Contact.tenantId.
  tenantId   String?

  research     String? // latest AI research briefing (shown in the Research tab)
  researchedAt DateTime?
  viewedAt     DateTime? // first time a staff member opened the lead
  stageEnteredAt DateTime @default(now()) // when it landed in the current stage (stale-age flag)

  deletedAt     DateTime?
  deletedByName String?
  deleteReason  String?

  stageId      String
