// System errors that would otherwise vanish into serverless logs
model ErrorLog {
  id        String   @id @default(cuid())
  scope     String // e.g. imap-sync, meta-webhook, smtp, pdf, unhandled
  message   String
  stack     String?
  context   String?
  /// Owning tenant, stamped best-effort from the request's tenant scope so errors
  /// can be attributed and filtered. NULLABLE and ErrorLog stays in GLOBAL_MODELS
  /// ON PURPOSE: errors happen on paths with no tenant (pre-auth failures,
  /// webhooks, cron, and tenant resolution itself failing). If this model were
  /// tenant-scoped, an unscoped write would fail closed under enforcement and the
  /// error log would disappear exactly when things are breaking. Logging must
  /// never throw, so attribution is a bonus, never a precondition.
