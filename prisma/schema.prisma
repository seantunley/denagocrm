model ServiceRecord {
  id          String    @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  serviceDate DateTime  @default(now())
  km          Int?
  summary     String
  details     String?
  nextDueKm   Int?
  nextDueDate DateTime?
  createdAt   DateTime  @default(now())

  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  jobCardId     String?  @unique
  jobCard       JobCard? @relation(fields: [jobCardId], references: [id])
  performedById String?
  performedBy   User?    @relation(fields: [performedById], references: [id])
  @@index([tenantId])
}

model JobCard {
  id          String    @id @default(cuid())
  tenantId String? // Multi-tenancy (Phase B — additive/inert): owning tenant.
  number      Int       @unique
  // Workshop stages: booking | checkin | diagnosis | approval | repair | qc | ready | collected | cancelled
  status      String    @default("booking")
  description String
  kmIn        Int?
  openedAt    DateTime  @default(now())
  completedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Workshop depth (phase 1)
  priority        String @default("normal") // low | normal | high | urgent
  estimatedHours  Float?
  labourRateCents Int? // per-job override; falls back to the workshop default setting
  bayId           String?
  bay             WorkshopBay? @relation(fields: [bayId], references: [id], onDelete: SetNull)

