# DenagoCRM environment. Copy to .env and fill in. Never commit real values.
# Integration credentials (SMTP, IMAP, Meta, AI providers, ElevenLabs, ...) are NOT here:
# they are set per workspace under Settings and stored encrypted in the database.

# ── Database (required) ─────────────────────────────────────────────────────────
# Use a LOCAL, disposable Postgres for development — never production.
DATABASE_URL=
# Direct (non-pooled) connection as the table OWNER. Used by the migration runner and Prisma CLI.
DATABASE_URL_UNPOOLED=
# Production only: the app connects as the crm_app role, which cannot bypass row-level security.
# Leave unset locally; the app then uses DATABASE_URL. See docs/RLS-ROLE-CUTOVER.md.
APP_DATABASE_URL=

# ── Secrets (required) ──────────────────────────────────────────────────────────
# Signs login sessions. Long random string.
SESSION_SECRET=
# 64 hex characters (32 bytes): encrypts stored credentials and backups. Keep a copy outside the app.
SETTINGS_ENCRYPTION_KEY=
# Bearer token Vercel cron (or any scheduler) sends to /api/cron/*.
CRON_SECRET=

# ── App ─────────────────────────────────────────────────────────────────────────
# Public origin, used in emails, signing links and tracking. Local: http://localhost:4000
NEXT_PUBLIC_APP_URL=
# Product name shown where no workspace brand applies (defaults to "CRM").
NEXT_PUBLIC_PLATFORM_NAME=
# off | monitor | enforce. Production runs "enforce". Local dev can leave it unset (off).
TENANT_ENFORCEMENT=

# ── First owner (used by `npx prisma db seed`) ─────────────────────────────────
INITIAL_ADMIN_EMAIL=
# At least 14 characters. Locally, leave blank to get a printed one-time password.
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=

# ── File storage (Vercel Blob) ──────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=
# Private store for customer documents; switch on with BLOB_PRIVATE=true once the token is set.
BLOB_PRIVATE_READ_WRITE_TOKEN=
BLOB_PRIVATE=
# Largest file read into memory, in bytes (default 64 MB).
MAX_BLOB_READ_BYTES=

# ── Web push (phone notifications) ──────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Extra allowed push-service hosts, comma-separated (the common ones are built in).
PUSH_ENDPOINT_HOSTS=

# ── E-signing ───────────────────────────────────────────────────────────────────
# Origin for signing links if different from NEXT_PUBLIC_APP_URL.
SIGN_BASE_URL=
# Secret for signer one-time codes (falls back to SESSION_SECRET).
SIGNING_OTP_SECRET=
# Server-wide PDF sealing certificate (.p12, base64) and its passphrase.
BUILDER_SIGN_P12_BASE64=
BUILDER_SIGN_P12_PASSPHRASE=
# compat (default) | strict — strict requires the certificate, private storage and these secrets
# before signing runs (src/lib/signing/securityPolicy.ts).
SIGNING_SECURITY_MODE=
# Trusted timestamps on sealed PDFs (on by default). Optional custom authority.
SIGNING_TSA_ENABLED=
SIGNING_TSA_URL=
SIGNING_TSA_TIMEOUT_MS=
SIGNING_TSA_ROOTS_PEM=

# ── Hardening (optional) ────────────────────────────────────────────────────────
# HMAC pepper for rate-limit keys (falls back to SESSION_SECRET).
RATE_LIMIT_PEPPER=
# Trust X-Forwarded-For when self-hosting behind a proxy that overwrites it (Vercel is detected).
TRUST_PROXY_HEADERS=
# Extra hosts allowed for images inside generated PDFs, comma-separated.
PDF_IMAGE_HOSTS=
# Extra hosts campaign click-tracking may redirect to, comma-separated.
CAMPAIGN_LINK_HOSTS=
