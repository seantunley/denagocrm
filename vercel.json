{
  "buildCommand": "prisma generate --schema ./prisma && prisma migrate deploy --schema ./prisma && next build",
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/cron/journeys",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/automations",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "0 2 * * *"
    }
  ]
}
